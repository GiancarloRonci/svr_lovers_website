---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const strings = {
  it: {
    brand: 'Il Paese',
    home: 'Home Page',
    nav: {
      news: 'News',
      storia: 'Storia',
      luoghi: 'Luoghi',
      percorsi: 'Percorsi',
      cosaFare: 'Cosa fare',
      eventi: 'Eventi & Feste',
      soggiorno: 'Dove Soggiornare',
      associazione: 'Associazione Culturale',
      contatti: 'Contatti',
      groupScopri: 'Scopri il Paese',
      groupCosaFare: 'Cosa Fare',
    },
    defaultDescription: 'Il paese: storia, percorsi, luoghi ed eventi.',
    footer: (year: number) => `© ${year} Il Paese. Sito realizzato dalla comunità.`,
  },
  en: {
    brand: 'The Village',
    home: 'Home Page',
    nav: {
      news: 'News',
      storia: 'History',
      luoghi: 'Places',
      percorsi: 'Trails',
      cosaFare: 'What to Do',
      eventi: 'Events & Festivals',
      soggiorno: 'Where to Stay',
      associazione: 'Cultural Association',
      contatti: 'Contact',
      groupScopri: 'Discover the Village',
      groupCosaFare: 'What to Do',
    },
    defaultDescription: 'The village: history, trails, places and events.',
    footer: (year: number) => `© ${year} The Village. Website made by the community.`,
  },
} as const;

const lang = Astro.currentLocale === 'en' ? 'en' : 'it';
const t = strings[lang];
const prefix = lang === 'en' ? 'en/' : '';

type NavLink = { type: 'link'; label: string; href: string };
type NavDropdown = { type: 'dropdown'; label: string; items: { label: string; href: string }[] };
const navItems: (NavLink | NavDropdown)[] = [
  { type: 'link', label: t.nav.news, href: withBase(`${prefix}news/`) },
  {
    type: 'dropdown',
    label: t.nav.groupScopri,
    items: [
      { label: t.nav.storia, href: withBase(`${prefix}storia/`) },
      { label: t.nav.luoghi, href: withBase(`${prefix}luoghi/`) },
      { label: t.nav.percorsi, href: withBase(`${prefix}percorsi/`) },
    ],
  },
  {
    type: 'dropdown',
    label: t.nav.groupCosaFare,
    items: [
      { label: t.nav.cosaFare, href: withBase(`${prefix}cosa-fare/`) },
      { label: t.nav.eventi, href: withBase(`${prefix}eventi/`) },
    ],
  },
  { type: 'link', label: t.nav.soggiorno, href: withBase(`${prefix}soggiorno/`) },
  { type: 'link', label: t.nav.associazione, href: withBase(`${prefix}associazione/`) },
  { type: 'link', label: t.nav.contatti, href: withBase(`${prefix}contatti/`) },
];

const { title, description = t.defaultDescription } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let relPath = Astro.url.pathname;
if (base && relPath.startsWith(base)) relPath = relPath.slice(base.length);
relPath = relPath.replace(/^\//, '');
const bare = relPath === 'en' ? '' : relPath.startsWith('en/') ? relPath.slice(3) : relPath;

const itHref = withBase(bare || '/');
const enHref = withBase(`en/${bare}`);
const switchHref = lang === 'en' ? itHref : enHref;
const switchLabel = lang === 'en' ? 'IT' : 'EN';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" hreflang="it" href={new URL(itHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(itHref, Astro.site)} />
    <title>{title} · {t.brand}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href={withBase(lang === 'en' ? 'en/' : '/')}>{t.home}</a>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
          <span></span><span></span><span></span>
        </button>
        <ul id="nav-links">
          {navItems.map((item) =>
            item.type === 'link' ? (
              <li><a href={item.href}>{item.label}</a></li>
            ) : (
              <li class="has-dropdown">
                <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                  {item.label} <span class="caret" aria-hidden="true">▾</span>
                </button>
                <ul class="dropdown-menu">
                  {item.items.map((sub) => (
                    <li><a href={sub.href}>{sub.label}</a></li>
                  ))}
                </ul>
              </li>
            )
          )}
          <li><a href={switchHref} class="lang-switch">{switchLabel}</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-contacts">
        <a href="mailto:info@sanvitoromanolovers.org">✉️ info@sanvitoromanolovers.org</a>
        <a href="tel:+393318280118">📞 331 828 0118</a>
        <a href="https://www.facebook.com/groups/sanvitoromano.lovers" target="_blank" rel="noopener noreferrer">🔵 Facebook</a>
        <a href="https://www.instagram.com/sanvitoromano.lovers/" target="_blank" rel="noopener noreferrer">📸 Instagram</a>
        <a href="https://www.tiktok.com/@sanvitoromano.lovers" target="_blank" rel="noopener noreferrer">🎵 TikTok</a>
      </p>
      <p>{t.footer(new Date().getFullYear())}</p>
    </footer>

    <script>
      const toggle = document.querySelector('.nav-toggle');
      const links = document.getElementById('nav-links');
      const dropdowns = document.querySelectorAll<HTMLLIElement>('.has-dropdown');

      toggle?.addEventListener('click', () => {
        const isOpen = links?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (!isOpen) closeAllDropdowns();
      });

      function closeAllDropdowns(except?: HTMLLIElement) {
        dropdowns.forEach((li) => {
          if (li === except) return;
          li.classList.remove('is-open');
          li.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
        });
      }

      dropdowns.forEach((li) => {
        const btn = li.querySelector('.dropdown-toggle');
        btn?.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = li.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          closeAllDropdowns(isOpen ? li : undefined);
        });
      });

      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Node)) return;
        const withinAnyDropdown = Array.from(dropdowns).some((li) => li.contains(e.target as Node));
        if (!withinAnyDropdown) closeAllDropdowns();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllDropdowns();
      });

      links?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.tagName === 'A') {
          links.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
          closeAllDropdowns();
        }
      });
    </script>

    <style is:global>
      :root {
        --color-bg: #fbf9f4;
        --color-text: #2b2b26;
        --color-accent: #6b7f3a;
        --color-accent-dark: #4d5c2a;
        --color-muted: #6f6b5f;
        --color-border: #e3ddcd;
        --font-body: system-ui, -apple-system, 'Segoe UI', sans-serif;
        --font-heading: Georgia, 'Times New Roman', serif;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }

      h1, h2, h3 { font-family: var(--font-heading); line-height: 1.2; }

      a { color: var(--color-accent-dark); }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }

      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: #fff;
      }

      .nav {
        max-width: 1000px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.5rem;
      }

      .brand {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: bold;
        text-decoration: none;
        color: var(--color-text);
      }

      .nav > ul {
        list-style: none;
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
      }

      .nav a {
        text-decoration: none;
        color: var(--color-text);
        font-size: 0.95rem;
        white-space: nowrap;
      }

      .nav a:hover { color: var(--color-accent-dark); }

      .has-dropdown {
        position: relative;
      }

      .dropdown-toggle {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        font-size: 0.95rem;
        color: var(--color-text);
        cursor: pointer;
        white-space: nowrap;
      }

      .dropdown-toggle:hover { color: var(--color-accent-dark); }

      .caret {
        font-size: 1.4em;
        transition: transform 0.15s ease;
      }

      .has-dropdown.is-open .caret {
        transform: rotate(180deg);
      }

      .dropdown-menu {
        list-style: none;
        margin: 0;
        padding: 0;
        display: none;
      }

      .lang-switch {
        font-weight: 700;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
      }

      .lang-switch:hover {
        border-color: var(--color-accent-dark);
      }

      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        margin-left: auto;
        width: 40px;
        height: 36px;
        padding: 0;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        background: #fff;
        cursor: pointer;
      }

      .nav-toggle span {
        display: block;
        width: 18px;
        height: 2px;
        margin: 0 auto;
        background: var(--color-text);
      }

      @media (min-width: 961px) {
        .dropdown-menu {
          position: absolute;
          top: 100%;
          left: 0;
          min-width: 190px;
          background: #fff;
          border: 1px solid var(--color-border);
          border-radius: 8px;
          box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
          padding: 0.5rem;
          z-index: 20;
        }

        .has-dropdown:hover .dropdown-menu,
        .has-dropdown:focus-within .dropdown-menu,
        .has-dropdown.is-open .dropdown-menu {
          display: flex;
          flex-direction: column;
        }

        .dropdown-menu li {
          width: 100%;
        }

        .dropdown-menu a {
          display: block;
          padding: 0.4rem 0.5rem;
          border-radius: 6px;
        }

        .dropdown-menu a:hover {
          background: var(--color-bg);
        }
      }

      @media (max-width: 960px) {
        .nav-toggle {
          display: flex;
        }

        .nav > ul {
          display: none;
          flex-direction: column;
          align-items: flex-start;
          flex-wrap: nowrap;
          gap: 0.9rem;
          flex-basis: 100%;
          order: 3;
          padding-top: 0.5rem;
        }

        .nav > ul.is-open {
          display: flex;
        }

        .has-dropdown {
          width: 100%;
        }

        .has-dropdown.is-open .dropdown-menu {
          display: flex;
        }

        .dropdown-menu {
          flex-direction: column;
          gap: 0.6rem;
          padding-left: 1rem;
          padding-top: 0.6rem;
          width: 100%;
        }
      }

      .site-footer {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--color-muted);
        font-size: 0.9rem;
        border-top: 1px solid var(--color-border);
      }

      .footer-contacts {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem 1.5rem;
        margin: 0 0 1rem;
      }

      .footer-contacts a {
        color: var(--color-text);
        text-decoration: none;
      }

      .footer-contacts a:hover {
        color: var(--color-accent-dark);
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .card-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
      }

      .card-list .card {
        display: flex;
        flex-direction: row;
      }

      .card-list .card img {
        width: 180px;
        flex-shrink: 0;
      }

      .card-list .card-body {
        flex: 1;
      }

      .card {
        border: 1px solid var(--color-border);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        text-decoration: none;
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.15s ease, transform 0.15s ease;
      }

      .card:hover {
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        transform: translateY(-2px);
      }

      .card img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
      }

      .card-body { padding: 1rem; }

      .card-body h3 { margin: 0 0 0.4rem; font-size: 1.05rem; }

      .card-body p { margin: 0; color: var(--color-muted); font-size: 0.92rem; }

      .tag {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        background: var(--color-accent);
        color: #fff;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        margin-bottom: 0.5rem;
      }

      .meta {
        color: var(--color-muted);
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
