---
import { withBase } from '../lib/url';
import { GA_MEASUREMENT_ID } from '../lib/analytics';

interface Props {
  title: string;
  description?: string;
}

const strings = {
  it: {
    brand: 'SanVitoRomano Lovers',
    home: 'Home Page',
    nav: {
      news: 'News',
      siteNews: 'News nel sito',
      latestPhotos: 'Ultime foto',
      storia: 'Storia',
      leggende: 'Leggende',
      luoghi: 'Luoghi',
      luoghiSanVito: 'A San Vito',
      luoghiDintorni: 'Dintorni',
      percorsi: 'Percorsi',
      articoli: 'Articoli',
      cosaFare: 'Cosa fare',
      eventi: 'Eventi & Feste',
      soggiorno: 'Dove Soggiornare',
      associazione: 'Cultura&Turismo',
      contatti: 'Contatti',
      groupScopri: 'Scopri il Paese',
      groupCosaFare: 'Cosa Fare',
      circoloScacchi: 'Scacchi',
      circoloDama: 'Dama',
      circoloBocce: 'Bocce',
      circoloProiezioneFilm: 'Proiezione Film',
      circoloProiezionePartite: 'Proiezione Partite',
      circoloOrientamentoTuristico: 'Orientamento Turistico',
      circoloPercorsiNaturalistici: 'Percorsi Naturalistici',
      circoloConcorsiFotografici: 'Contest Fotografico',
    },
    defaultDescription: 'Il paese: storia, percorsi, luoghi ed eventi.',
    footer: (year: number) => `© ${year} Il Paese. Sito realizzato dalla comunità.`,
    privacy: 'Privacy e cookie',
    cookie: {
      label: 'Consenso ai cookie',
      text: 'Questo sito usa Google Analytics per contare le visite e capire quali pagine vengono lette. I cookie di Analytics vengono installati solo se accetti.',
      more: 'Maggiori informazioni',
      accept: 'Accetta',
      reject: 'Rifiuta',
      prefs: 'Preferenze cookie',
    },
  },
  en: {
    brand: 'SanVitoRomano Lovers',
    home: 'Home Page',
    nav: {
      news: 'News',
      siteNews: 'Site News',
      latestPhotos: 'Latest Photos',
      storia: 'History',
      leggende: 'Legends',
      luoghi: 'Places',
      luoghiSanVito: 'In San Vito',
      luoghiDintorni: 'Surroundings',
      percorsi: 'Trails',
      articoli: 'Articles',
      cosaFare: 'What to Do',
      eventi: 'Events & Festivals',
      soggiorno: 'Where to Stay',
      associazione: 'Culture&Tourism',
      contatti: 'Contact',
      groupScopri: 'Discover the Village',
      groupCosaFare: 'What to Do',
      circoloScacchi: 'Chess',
      circoloDama: 'Checkers',
      circoloBocce: 'Bocce',
      circoloProiezioneFilm: 'Film Screenings',
      circoloProiezionePartite: 'Match Screenings',
      circoloOrientamentoTuristico: 'Tourist Guidance',
      circoloPercorsiNaturalistici: 'Nature Trails',
      circoloConcorsiFotografici: 'Photo Contest',
    },
    defaultDescription: 'The village: history, trails, places and events.',
    footer: (year: number) => `© ${year} The Village. Website made by the community.`,
    privacy: 'Privacy and cookies',
    cookie: {
      label: 'Cookie consent',
      text: 'This site uses Google Analytics to count visits and understand which pages are read. Analytics cookies are set only if you accept.',
      more: 'More information',
      accept: 'Accept',
      reject: 'Reject',
      prefs: 'Cookie preferences',
    },
  },
} as const;

const lang = Astro.currentLocale === 'en' ? 'en' : 'it';
const t = strings[lang];
const prefix = lang === 'en' ? 'en/' : '';

type NavLink = { type: 'link'; label: string; href: string };
type NavDropdown = { type: 'dropdown'; label: string; items: { label: string; href: string }[] };
const navItems: (NavLink | NavDropdown)[] = [
  {
    type: 'dropdown',
    label: t.nav.luoghi,
    items: [
      { label: t.nav.luoghiSanVito, href: withBase(`${prefix}luoghi/#a-san-vito`) },
      { label: t.nav.luoghiDintorni, href: withBase(`${prefix}luoghi/#dintorni`) },
    ],
  },
  {
    type: 'dropdown',
    label: t.nav.groupScopri,
    items: [
      { label: t.nav.news, href: withBase(`${prefix}news/`) },
      { label: t.nav.storia, href: withBase(`${prefix}storia/`) },
      { label: t.nav.leggende, href: withBase(`${prefix}leggende/`) },
      { label: t.nav.percorsi, href: withBase(`${prefix}percorsi/`) },
      { label: t.nav.articoli, href: withBase(`${prefix}articoli/`) },
      { label: t.nav.siteNews, href: withBase(`${prefix}aggiornamenti/`) },
      { label: t.nav.latestPhotos, href: withBase(`${prefix}ultime-foto/`) },
    ],
  },
  {
    type: 'dropdown',
    label: t.nav.groupCosaFare,
    items: [
      { label: t.nav.cosaFare, href: withBase(`${prefix}cosa-fare/`) },
      { label: t.nav.eventi, href: withBase(`${prefix}eventi/`) },
    ],
  },
  { type: 'link', label: t.nav.soggiorno, href: withBase(`${prefix}soggiorno/`) },
  {
    type: 'dropdown',
    label: t.nav.associazione,
    items: [
      { label: t.nav.circoloScacchi, href: withBase(`${prefix}culturaturismo/#scacchi`) },
      { label: t.nav.circoloDama, href: withBase(`${prefix}culturaturismo/#dama`) },
      { label: t.nav.circoloBocce, href: withBase(`${prefix}culturaturismo/#bocce`) },
      { label: t.nav.circoloProiezioneFilm, href: withBase(`${prefix}culturaturismo/#proiezione-film`) },
      { label: t.nav.circoloProiezionePartite, href: withBase(`${prefix}culturaturismo/#proiezione-partite`) },
      { label: t.nav.circoloOrientamentoTuristico, href: withBase(`${prefix}culturaturismo/#orientamento-turistico`) },
      { label: t.nav.circoloPercorsiNaturalistici, href: withBase(`${prefix}culturaturismo/#percorsi-naturalistici`) },
      { label: t.nav.circoloConcorsiFotografici, href: withBase(`${prefix}culturaturismo/#concorsi-fotografici`) },
    ],
  },
  { type: 'link', label: t.nav.contatti, href: withBase(`${prefix}contatti/`) },
];

const { title, description = t.defaultDescription } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let relPath = Astro.url.pathname;
if (base && relPath.startsWith(base)) relPath = relPath.slice(base.length);
relPath = relPath.replace(/^\//, '');
const bare = relPath === 'en' ? '' : relPath.startsWith('en/') ? relPath.slice(3) : relPath;

const itHref = withBase(bare || '/');
const enHref = withBase(`en/${bare}`);
const switchHref = lang === 'en' ? itHref : enHref;
const switchLabel = lang === 'en' ? 'IT' : 'EN';
const gaId = GA_MEASUREMENT_ID;
const privacyHref = withBase(`${prefix}privacy/`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" hreflang="it" href={new URL(itHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(itHref, Astro.site)} />
    <title>{title} · {t.brand}</title>
    {
      gaId && (
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.svrLoadAnalytics = function () {
            if (window.svrAnalyticsLoaded) return;
            window.svrAnalyticsLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
            window.gtag('js', new Date());
            window.gtag('config', gaId);
          };
          try {
            if (localStorage.getItem('svr-cookie-consent') === 'granted') window.svrLoadAnalytics();
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href={withBase(lang === 'en' ? 'en/' : '/')}>{t.home}</a>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
          <span></span><span></span><span></span>
        </button>
        <ul id="nav-links">
          {navItems.map((item) =>
            item.type === 'link' ? (
              <li><a href={item.href}>{item.label}</a></li>
            ) : (
              <li class="has-dropdown">
                <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                  {item.label} <span class="caret" aria-hidden="true">▾</span>
                </button>
                <ul class="dropdown-menu">
                  {item.items.map((sub) => (
                    <li><a href={sub.href}>{sub.label}</a></li>
                  ))}
                </ul>
              </li>
            )
          )}
          <li><a href={switchHref} class="lang-switch">{switchLabel}</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-contacts">
        <a href="mailto:info@sanvitoromanolovers.org">✉️ info@sanvitoromanolovers.org</a>
        <a href="tel:+393318280118">📞 +39 331 828 0118</a>
        <a href="https://www.facebook.com/groups/sanvitoromano.lovers" target="_blank" rel="noopener noreferrer">🔵 Facebook</a>
        <a href="https://www.instagram.com/sanvitoromano.lovers/" target="_blank" rel="noopener noreferrer">📸 Instagram</a>
        <a href="https://www.tiktok.com/@sanvitoromano.lovers" target="_blank" rel="noopener noreferrer">🎵 TikTok</a>
      </p>
      <p>{t.footer(new Date().getFullYear())}</p>
      <p class="footer-legal">
        <a href={privacyHref}>{t.privacy}</a>
        {gaId && <button type="button" id="cookie-prefs">{t.cookie.prefs}</button>}
      </p>
    </footer>

    {
      gaId && (
        <div id="cookie-banner" class="cookie-banner" role="dialog" aria-label={t.cookie.label} hidden>
          <p>
            {t.cookie.text} <a href={privacyHref}>{t.cookie.more}</a>
          </p>
          <div class="cookie-actions">
            <button type="button" id="cookie-reject">{t.cookie.reject}</button>
            <button type="button" id="cookie-accept">{t.cookie.accept}</button>
          </div>
        </div>
      )
    }
    {
      gaId && (
        <script is:inline>
          (function () {
            var KEY = 'svr-cookie-consent';
            var banner = document.getElementById('cookie-banner');
            if (!banner) return;
            var stored = null;
            try {
              stored = localStorage.getItem(KEY);
            } catch (e) {}
            if (!stored) banner.hidden = false;
            function save(value) {
              try {
                localStorage.setItem(KEY, value);
              } catch (e) {}
              banner.hidden = true;
            }
            function clearAnalyticsCookies() {
              var host = location.hostname;
              var domains = ['', host, '.' + host, '.' + host.replace(/^www\./, '')];
              document.cookie.split(';').forEach(function (c) {
                var name = c.split('=')[0].trim();
                if (name.indexOf('_ga') !== 0) return;
                domains.forEach(function (d) {
                  document.cookie =
                    name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + (d ? '; domain=' + d : '');
                });
              });
            }
            document.getElementById('cookie-accept').addEventListener('click', function () {
              save('granted');
              if (window.svrLoadAnalytics) window.svrLoadAnalytics();
            });
            document.getElementById('cookie-reject').addEventListener('click', function () {
              save('denied');
              clearAnalyticsCookies();
              if (window.svrAnalyticsLoaded) location.reload();
            });
            var prefs = document.getElementById('cookie-prefs');
            if (prefs)
              prefs.addEventListener('click', function () {
                banner.hidden = false;
              });
          })();
        </script>
      )
    }

    <script>
      const toggle = document.querySelector('.nav-toggle');
      const links = document.getElementById('nav-links');
      const dropdowns = document.querySelectorAll<HTMLLIElement>('.has-dropdown');

      toggle?.addEventListener('click', () => {
        const isOpen = links?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (!isOpen) closeAllDropdowns();
      });

      function closeAllDropdowns(except?: HTMLLIElement) {
        dropdowns.forEach((li) => {
          if (li === except) return;
          li.classList.remove('is-open');
          li.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
        });
      }

      dropdowns.forEach((li) => {
        const btn = li.querySelector('.dropdown-toggle');
        btn?.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = li.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          closeAllDropdowns(isOpen ? li : undefined);
        });
      });

      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Node)) return;
        const withinAnyDropdown = Array.from(dropdowns).some((li) => li.contains(e.target as Node));
        if (!withinAnyDropdown) closeAllDropdowns();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllDropdowns();
      });

      links?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.tagName === 'A') {
          links.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
          closeAllDropdowns();
        }
      });
    </script>

    <style is:global>
      :root {
        --color-bg: #fbf9f4;
        --color-text: #2b2b26;
        --color-accent: #6b7f3a;
        --color-accent-dark: #4d5c2a;
        --color-muted: #6f6b5f;
        --color-border: #e3ddcd;
        --font-body: system-ui, -apple-system, 'Segoe UI', sans-serif;
        --font-heading: Georgia, 'Times New Roman', serif;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }

      h1, h2, h3 { font-family: var(--font-heading); line-height: 1.2; }

      a { color: var(--color-accent-dark); }

      article img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 1.5rem auto;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }

      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: #fff;
      }

      .nav {
        max-width: 1000px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.5rem;
      }

      .brand {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: bold;
        text-decoration: none;
        color: var(--color-text);
      }

      .nav > ul {
        list-style: none;
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
      }

      .nav a {
        text-decoration: none;
        color: var(--color-text);
        font-size: 0.95rem;
        white-space: nowrap;
      }

      .nav a:hover { color: var(--color-accent-dark); }

      .has-dropdown {
        position: relative;
      }

      .dropdown-toggle {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        font-size: 0.95rem;
        color: var(--color-text);
        cursor: pointer;
        white-space: nowrap;
      }

      .dropdown-toggle:hover { color: var(--color-accent-dark); }

      .caret {
        font-size: 1.4em;
        transition: transform 0.15s ease;
      }

      .has-dropdown.is-open .caret {
        transform: rotate(180deg);
      }

      .dropdown-menu {
        list-style: none;
        margin: 0;
        padding: 0;
        display: none;
      }

      .lang-switch {
        font-weight: 700;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
      }

      .lang-switch:hover {
        border-color: var(--color-accent-dark);
      }

      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        margin-left: auto;
        width: 40px;
        height: 36px;
        padding: 0;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        background: #fff;
        cursor: pointer;
      }

      .nav-toggle span {
        display: block;
        width: 18px;
        height: 2px;
        margin: 0 auto;
        background: var(--color-text);
      }

      @media (min-width: 961px) {
        .dropdown-menu {
          position: absolute;
          top: 100%;
          left: 0;
          min-width: 190px;
          background: #fff;
          border: 1px solid var(--color-border);
          border-radius: 8px;
          box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
          padding: 0.5rem;
          z-index: 20;
        }

        .has-dropdown:hover .dropdown-menu,
        .has-dropdown:focus-within .dropdown-menu,
        .has-dropdown.is-open .dropdown-menu {
          display: flex;
          flex-direction: column;
        }

        .dropdown-menu li {
          width: 100%;
        }

        .dropdown-menu a {
          display: block;
          padding: 0.4rem 0.5rem;
          border-radius: 6px;
        }

        .dropdown-menu a:hover {
          background: var(--color-bg);
        }
      }

      @media (max-width: 960px) {
        .nav-toggle {
          display: flex;
        }

        .nav > ul {
          display: none;
          flex-direction: column;
          align-items: flex-start;
          flex-wrap: nowrap;
          gap: 0.9rem;
          flex-basis: 100%;
          order: 3;
          padding-top: 0.5rem;
        }

        .nav > ul.is-open {
          display: flex;
        }

        .has-dropdown {
          width: 100%;
        }

        .has-dropdown.is-open .dropdown-menu {
          display: flex;
        }

        .dropdown-menu {
          flex-direction: column;
          gap: 0.6rem;
          padding-left: 1rem;
          padding-top: 0.6rem;
          width: 100%;
        }
      }

      .site-footer {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--color-muted);
        font-size: 0.9rem;
        border-top: 1px solid var(--color-border);
      }

      .footer-contacts {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem 1.5rem;
        margin: 0 0 1rem;
      }

      .footer-contacts a {
        color: var(--color-text);
        text-decoration: none;
      }

      .footer-contacts a:hover {
        color: var(--color-accent-dark);
      }

      .footer-legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.5rem;
        font-size: 0.85rem;
      }

      .footer-legal a,
      .footer-legal button {
        color: var(--color-muted);
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        text-decoration: underline;
        cursor: pointer;
      }

      .cookie-banner {
        position: fixed;
        left: 1rem;
        right: 1rem;
        bottom: 1rem;
        z-index: 50;
        max-width: 720px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.5rem;
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        font-size: 0.92rem;
      }

      .cookie-banner[hidden] {
        display: none;
      }

      .cookie-banner p {
        margin: 0;
        flex: 1 1 320px;
      }

      .cookie-actions {
        display: flex;
        gap: 0.75rem;
      }

      .cookie-actions button {
        font: inherit;
        font-weight: 700;
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
        border: 1px solid var(--color-accent-dark);
        background: var(--color-accent-dark);
        color: #fff;
        cursor: pointer;
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .card-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
      }

      .card-list .card {
        display: flex;
        flex-direction: row;
      }

      .card-list .card img {
        width: 180px;
        flex-shrink: 0;
      }

      .card-list .card-body {
        flex: 1;
      }

      .card {
        border: 1px solid var(--color-border);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        text-decoration: none;
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.15s ease, transform 0.15s ease;
      }

      .card:hover {
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        transform: translateY(-2px);
      }

      .card img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
      }

      .card-body { padding: 1rem; }

      .card-body h3 { margin: 0 0 0.4rem; font-size: 1.05rem; }

      .card-body p { margin: 0; color: var(--color-muted); font-size: 0.92rem; }

      .tag {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        background: var(--color-accent);
        color: #fff;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        margin-bottom: 0.5rem;
      }
      .tag--sagra { background: #b5541c; }
      .tag--concerto { background: #8a2f6b; }
      .tag--cultura { background: #4a4f9a; }
      .tag--religioso { background: #7d6320; }
      .tag--sport { background: #1d6f8a; }
      .tag--escursione { background: #3d6b2a; }
      .tag--teatro { background: #a3303a; }
      .tag--cittadino { background: #5c6770; }
      .tag--auto { background: #6e4a2e; }

      .meta {
        color: var(--color-muted);
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
