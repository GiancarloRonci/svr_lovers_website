---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const strings = {
  it: {
    brand: 'Il Paese',
    home: 'Home Page',
    nav: {
      news: 'News',
      storia: 'Storia',
      luoghi: 'Luoghi',
      percorsi: 'Percorsi',
      cosaFare: 'Cosa fare',
      eventi: 'Eventi & Feste',
      soggiorno: 'Dove Soggiornare',
      associazione: 'Associazione Culturale',
    },
    defaultDescription: 'Il paese: storia, percorsi, luoghi ed eventi.',
    footer: (year: number) => `© ${year} Il Paese. Sito realizzato dalla comunità.`,
  },
  en: {
    brand: 'The Village',
    home: 'Home Page',
    nav: {
      news: 'News',
      storia: 'History',
      luoghi: 'Places',
      percorsi: 'Trails',
      cosaFare: 'What to Do',
      eventi: 'Events & Festivals',
      soggiorno: 'Where to Stay',
      associazione: 'Cultural Association',
    },
    defaultDescription: 'The village: history, trails, places and events.',
    footer: (year: number) => `© ${year} The Village. Website made by the community.`,
  },
} as const;

const lang = Astro.currentLocale === 'en' ? 'en' : 'it';
const t = strings[lang];

const { title, description = t.defaultDescription } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let relPath = Astro.url.pathname;
if (base && relPath.startsWith(base)) relPath = relPath.slice(base.length);
relPath = relPath.replace(/^\//, '');
const bare = relPath === 'en' ? '' : relPath.startsWith('en/') ? relPath.slice(3) : relPath;

const itHref = withBase(bare || '/');
const enHref = withBase(`en/${bare}`);
const switchHref = lang === 'en' ? itHref : enHref;
const switchLabel = lang === 'en' ? 'IT' : 'EN';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" hreflang="it" href={new URL(itHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(itHref, Astro.site)} />
    <title>{title} · {t.brand}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href={withBase(lang === 'en' ? 'en/' : '/')}>{t.home}</a>
        <ul>
          <li><a href={withBase(lang === 'en' ? 'en/news/' : 'news/')}>{t.nav.news}</a></li>
          <li><a href={withBase(lang === 'en' ? 'en/storia/' : 'storia/')}>{t.nav.storia}</a></li>
          <li><a href={withBase(lang === 'en' ? 'en/luoghi/' : 'luoghi/')}>{t.nav.luoghi}</a></li>
          <li><a href={withBase(lang === 'en' ? 'en/percorsi/' : 'percorsi/')}>{t.nav.percorsi}</a></li>
          <li><a href={withBase(lang === 'en' ? 'en/cosa-fare/' : 'cosa-fare/')}>{t.nav.cosaFare}</a></li>
          <li><a href={withBase(lang === 'en' ? 'en/eventi/' : 'eventi/')}>{t.nav.eventi}</a></li>
          <li><a href={withBase(lang === 'en' ? 'en/soggiorno/' : 'soggiorno/')}>{t.nav.soggiorno}</a></li>
          <li><a href={withBase(lang === 'en' ? 'en/associazione/' : 'associazione/')}>{t.nav.associazione}</a></li>
          <li><a href={switchHref} class="lang-switch">{switchLabel}</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{t.footer(new Date().getFullYear())}</p>
    </footer>

    <style is:global>
      :root {
        --color-bg: #fbf9f4;
        --color-text: #2b2b26;
        --color-accent: #6b7f3a;
        --color-accent-dark: #4d5c2a;
        --color-muted: #6f6b5f;
        --color-border: #e3ddcd;
        --font-body: system-ui, -apple-system, 'Segoe UI', sans-serif;
        --font-heading: Georgia, 'Times New Roman', serif;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }

      h1, h2, h3 { font-family: var(--font-heading); line-height: 1.2; }

      a { color: var(--color-accent-dark); }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }

      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: #fff;
      }

      .nav {
        max-width: 1000px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.5rem;
      }

      .brand {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: bold;
        text-decoration: none;
        color: var(--color-text);
      }

      .nav ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
      }

      .nav a {
        text-decoration: none;
        color: var(--color-text);
        font-size: 0.95rem;
      }

      .nav a:hover { color: var(--color-accent-dark); }

      .lang-switch {
        font-weight: 700;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
      }

      .lang-switch:hover {
        border-color: var(--color-accent-dark);
      }

      .site-footer {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--color-muted);
        font-size: 0.9rem;
        border-top: 1px solid var(--color-border);
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .card {
        border: 1px solid var(--color-border);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        text-decoration: none;
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.15s ease, transform 0.15s ease;
      }

      .card:hover {
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        transform: translateY(-2px);
      }

      .card img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
      }

      .card-body { padding: 1rem; }

      .card-body h3 { margin: 0 0 0.4rem; font-size: 1.05rem; }

      .card-body p { margin: 0; color: var(--color-muted); font-size: 0.92rem; }

      .tag {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        background: var(--color-accent);
        color: #fff;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        margin-bottom: 0.5rem;
      }

      .meta {
        color: var(--color-muted);
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
