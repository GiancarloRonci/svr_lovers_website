---
import Layout from '../../layouts/Layout.astro';
import TrailMap from '../../components/TrailMap.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { resolveGalleria } from '../../lib/gallery';
import { formatCredit } from '../../lib/photoCredit';
import { getLastModified, formatLastModified } from '../../lib/lastModified';

export async function getStaticPaths() {
  const percorsi = await getCollection('percorsi');
  return percorsi.map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { title, description, tipo, difficolta, difficoltaNota, lunghezzaKm, durata, dislivello, immagine, immagineAutore, immagineLicenza, galleria, gpx, partenza, foto } =
  entry.data;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);

const fotoResolved = foto
  ? await Promise.all(
      foto.map(async (f, i) => ({
        lat: f.lat,
        lng: f.lng,
        src: (await getImage({ src: f.immagine, width: 300 })).src,
        full: (await getImage({ src: f.immagine, width: 1400 })).src,
        didascalia: f.didascalia,
        credit: formatCredit(f.autore, f.licenza),
        name: `Foto ${i + 1}`,
      }))
    )
  : [];

const galleryItems = [
  ...fotoResolved.map((f, i) => ({
    immagine: foto![i].immagine,
    full: f.full,
    alt: f.didascalia || `${title} - foto ${i + 1}`,
    caption: f.didascalia ?? '',
    credit: f.credit,
    lat: f.lat,
    lng: f.lng,
    name: `Foto ${i + 1}`,
  })),
  ...(await resolveGalleria(galleria, title, fotoResolved.length)).map((item, i) => ({
    ...item,
    name: `Foto ${fotoResolved.length + i + 1}`,
  })),
];
---

<Layout title={title} description={description}>
  <a data-pagefind-ignore href={withBase('percorsi/')}>&larr; Tutti i percorsi</a>
  <h1>{title}</h1>
  <p class="meta">
    {tipo} · {difficolta}{difficoltaNota && ` ${difficoltaNota}`} · {lunghezzaKm} km · {durata}
    {dislivello && ` · dislivello ${dislivello}`}
  </p>
  {lastModified && <p class="aggiornato">Ultimo aggiornamento: {formatLastModified(lastModified, 'it-IT')}</p>}

  {
    immagine && (
      <div class="cover">
        <Image class="cover-image" src={immagine} alt={title} width={900} height={500} />
        <span class="cover-credit">{formatCredit(immagineAutore, immagineLicenza)}</span>
      </div>
    )
  }

  <article>
    <Content />
  </article>
  <p class="segnalazioni">
    Hai trovato un'inesattezza in questo testo, o vuoi aggiungere qualche dettaglio? Scrivici
    a <a href="mailto:info@sanvitoromanolovers.org">info@sanvitoromanolovers.org</a>: è anche grazie alle vostre
    segnalazioni che il sito può migliorare sempre di più.
  </p>

  {(gpx || partenza || fotoResolved.length > 0) && (
    <>
      <p class="nota-mappa">
        Una volta sulla mappa del percorso, tocca il pulsante 📍 per individuare la tua posizione attuale e fatti guidare
        dalla mappa stessa.
      </p>
      <TrailMap gpx={gpx} partenza={partenza} foto={fotoResolved} numerata />
    </>
  )}

  {gpx && (
    <p>
      <a href={withBase(gpx)} download>&darr; Scarica la traccia GPX</a>
    </p>
  )}

  <PhotoGallery items={galleryItems} numerata titolo="Foto lungo il percorso" />
</Layout>

<style>
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .cover {
    position: relative;
  }
  .cover-credit {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.75rem;
  }

  .cover-image {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .nota-mappa {
    font-size: 0.9rem;
  }

  .segnalazioni {
    font-size: 0.9rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
