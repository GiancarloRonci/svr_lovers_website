---
import Layout from '../../layouts/Layout.astro';
import TrailMap from '../../components/TrailMap.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { resolveGalleria } from '../../lib/gallery';

export async function getStaticPaths() {
  const percorsi = await getCollection('percorsi');
  return percorsi.map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { title, description, tipo, difficolta, lunghezzaKm, durata, dislivello, immagine, galleria, gpx, partenza, foto } =
  entry.data;
const { Content } = await render(entry);

const fotoResolved = foto
  ? await Promise.all(
      foto.map(async (f, i) => ({
        lat: f.lat,
        lng: f.lng,
        src: (await getImage({ src: f.immagine, width: 300 })).src,
        full: (await getImage({ src: f.immagine, width: 1400 })).src,
        didascalia: f.didascalia,
        name: `Foto ${i + 1}`,
      }))
    )
  : [];

const galleryItems = [
  ...fotoResolved.map((f, i) => ({
    immagine: foto![i].immagine,
    full: f.full,
    alt: f.didascalia || `${title} - foto ${i + 1}`,
    caption: f.didascalia ?? '',
    name: `Foto ${i + 1}`,
  })),
  ...(await resolveGalleria(galleria, title, fotoResolved.length)).map((item, i) => ({
    ...item,
    name: `Foto ${fotoResolved.length + i + 1}`,
  })),
];
---

<Layout title={title} description={description}>
  <a href={withBase('percorsi/')}>&larr; Tutti i percorsi</a>
  <h1>{title}</h1>
  <p class="meta">
    {tipo} · {difficolta} · {lunghezzaKm} km · {durata}
    {dislivello && ` · dislivello ${dislivello}`}
  </p>

  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}

  <article>
    <Content />
  </article>

  {(gpx || partenza || fotoResolved.length > 0) && (
    <TrailMap gpx={gpx} partenza={partenza} foto={fotoResolved} />
  )}

  {gpx && (
    <p>
      <a href={withBase(gpx)} download>&darr; Scarica la traccia GPX</a>
    </p>
  )}

  {
    fotoResolved.length > 0 && (
      <section class="foto-elenco">
        <h2>Foto lungo il percorso</h2>
        <ul>
          {fotoResolved.map((f, i) => (
            <li>
              <strong>Foto {i + 1}</strong>
              {f.didascalia && `: ${f.didascalia}`}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    galleryItems.length > 0 && (
      <section class="gallery">
        {galleryItems.map((item) => (
          <button type="button" class="gallery-item" data-full={item.full} data-caption={item.caption} data-name={item.name}>
            <Image src={item.immagine} alt={item.alt} width={400} height={300} />
          </button>
        ))}
      </section>
    )
  }

  <div class="lightbox" id="lightbox" hidden>
    <button type="button" class="lightbox-close" aria-label="Chiudi">&times;</button>
    <button type="button" class="lightbox-prev" aria-label="Foto precedente">&larr;</button>
    <figure class="lightbox-figure">
      <img class="lightbox-img" alt="" />
      <figcaption class="lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="lightbox-next" aria-label="Foto successiva">&rarr;</button>
  </div>
</Layout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .gallery-item {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox-figure {
    margin: 0;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .lightbox-img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 4px;
  }
  .lightbox-caption {
    color: #fff;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }
  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  const gallery = document.querySelector('.gallery');
  const lightbox = document.getElementById('lightbox');

  if (gallery && lightbox) {
    const items = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery-item'));
    const img = lightbox.querySelector('.lightbox-img') as HTMLImageElement;
    const caption = lightbox.querySelector('.lightbox-caption') as HTMLElement;
    let current = 0;

    const render = () => {
      img.src = items[current].dataset.full ?? '';
      const name = items[current].dataset.name ?? '';
      const desc = items[current].dataset.caption ?? '';
      caption.textContent = desc ? `${name}: ${desc}` : name;
    };
    const open = (i: number) => {
      current = i;
      render();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    };
    const move = (delta: number) => {
      current = (current + delta + items.length) % items.length;
      render();
    };

    items.forEach((item, i) => item.addEventListener('click', () => open(i)));
    lightbox.querySelector('.lightbox-close')?.addEventListener('click', close);
    lightbox.querySelector('.lightbox-prev')?.addEventListener('click', () => move(-1));
    lightbox.querySelector('.lightbox-next')?.addEventListener('click', () => move(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') move(-1);
      if (e.key === 'ArrowRight') move(1);
    });
  }
</script>
