---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';

const attivita = await getCollection('associazione');

const etichette: Record<string, string> = {
  scacchi: 'Scacchi',
  dama: 'Dama',
  bocce: 'Bocce',
  'proiezione-film': 'Proiezione Film',
  'proiezione-partite': 'Proiezione Partite',
  altro: 'Altre attività',
};

const categorie = ['scacchi', 'dama', 'bocce', 'proiezione-film', 'proiezione-partite', 'altro'] as const;
---

<Layout
  title="Circolo Culturale"
  description="Le attività del circolo culturale del paese: scacchi, dama, bocce e proiezioni insieme."
>
  <h1>Circolo Culturale</h1>
  <p class="meta">
    Un punto di ritrovo per la comunità: tornei, sfide e serate condivise attorno alle nostre
    attività preferite.
  </p>

  {
    categorie.map((cat) => {
      const items = attivita.filter((a) => a.data.categoria === cat);
      if (items.length === 0) return null;
      return (
        <section id={cat}>
          <h2>{etichette[cat]}</h2>
          <div class="card-grid">
            {items.map((a) => (
              <Card
                href={withBase(`associazione/${a.id}/`)}
                title={a.data.title}
                description={a.data.frequenza ?? a.data.description}
                image={a.data.immagine}
              />
            ))}
          </div>
        </section>
      );
    })
  }
</Layout>
