---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import CategorieArticoli from '../../components/CategorieArticoli.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';
import { byInsertionDesc } from '../../lib/insertionOrder';
import { categoriaArticolo } from '../../lib/categorieArticoli';

const articoli = (await getCollection('articoli')).sort(byInsertionDesc);
---

<Layout cercabile={false} title="Articoli" description="Articoli della community su San Vito Romano.">
  <h1>Articoli</h1>
  <p class="meta">Racconti, approfondimenti e curiosità su San Vito Romano scritti dalla community.</p>

  <CategorieArticoli lang="it" />

  <div class="card-grid">
    {
      articoli.map((a) => (
        <Card
          href={withBase(`articoli/${a.id}/`)}
          title={a.data.title}
          description={a.data.description}
          tag={categoriaArticolo(a.data.categoria).it.nome}
          meta={a.data.data?.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}
          image={a.data.immagine}
          imagePosition={a.data.copertinaPosizione}
        />
      ))
    }
  </div>
</Layout>
