---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { resolveGalleria } from '../../lib/gallery';
import { getLastModified, formatLastModified } from '../../lib/lastModified';
import { weekendDatesFromSlug } from '../../lib/weekend';
import Meteo3b from '../../components/Meteo3b.astro';

export async function getStaticPaths() {
  const articoli = await getCollection('articoli');
  return articoli.map((a) => ({ params: { id: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { title, description, data, autore, categoria, immagine, immagineIntera: immagineInteraFlag, copertinaBassa, galleria } = entry.data;
// Nei "Viaggi nel tempo" e nelle "Storie in sanvitese" l'immagine è il cuore dell'articolo: si mostra intera, senza ritaglio (o quando lo chiede `immagineIntera`)
const immagineIntera = categoria === 'viaggi-nel-tempo' || categoria === 'storie-in-sanvitese' || immagineInteraFlag === true;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);
// Nei consigli del weekend i link agli eventi già rimossi dalla collection diventano testo semplice,
// e accanto agli altri compaiono i minuti di auto da San Vito presi dalla scheda dell'evento
const eventiWeekend = categoria === 'weekend' ? await getCollection('eventi') : null;
const eventiAttivi = eventiWeekend ? eventiWeekend.map((e) => e.id) : null;
const minutiEventi = eventiWeekend
  ? Object.fromEntries(eventiWeekend.filter((e) => e.data.minutiAuto).map((e) => [e.id, e.data.minutiAuto]))
  : null;
const etichettaMinuti = 'circa {n} min in auto da San Vito';
const weekend = categoria === 'weekend' ? weekendDatesFromSlug(entry.id) : null;

const galleryItems = (await resolveGalleria(galleria, title)).map((item, i) => ({
  ...item,
  name: `Foto ${i + 1}`,
}));
---

<Layout title={title} description={description}>
  <a data-pagefind-ignore href={withBase('articoli/')}>&larr; Tutti gli articoli</a>
  <h1>{title}</h1>
  <p class="meta">
    {data && <>{data.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}</>}
    {data && autore && <> · </>}
    {autore && <>{autore}</>}
  </p>
  {lastModified && <p class="aggiornato">Ultimo aggiornamento: {formatLastModified(lastModified, 'it-IT')}</p>}
  {immagine && !immagineIntera && <Image class="articolo-image" src={immagine} alt={title} width={900} height={500} />}
  {immagine && immagineIntera && <Image class:list={['articolo-image-intera', { bassa: copertinaBassa }]} src={immagine} alt={title} />}
  {
    categoria === 'weekend' && (
      <>
      <p class="avviso">
        <strong>Scegli tu cosa fare.</strong> Qui sono riassunti tutti gli eventi rilevanti del
        weekend, ma non serve partecipare a tutto: scegli quelli che preferisci in base ai tuoi gusti
        e al tempo che hai a disposizione. Accanto a ogni evento fuori paese trovi i minuti di auto
        per arrivarci da San Vito.
      </p>
      <p class="avviso">
        <strong>Prima di partire, verifica sempre.</strong> Controlla presso gli organizzatori o le
        fonti ufficiali che l'evento sia confermato e che orari e dettagli non siano cambiati: i
        programmi possono subire variazioni o annullamenti all'ultimo momento.
      </p>
      </>
    )
  }
  {weekend && <Meteo3b lang="it" weekendFine={weekend.fine} />}
  <article class:list={{ poesia: categoria === 'storie-in-sanvitese' }}>
    <Content />
  </article>
  {
    eventiAttivi && (
      <script is:inline define:vars={{ eventiAttivi, minutiEventi, etichettaMinuti }}>
        var giaIndicati = {};
        document.querySelectorAll('article a[href*="/eventi/"]').forEach(function (a) {
          var m = a.getAttribute('href').match(/\/eventi\/([^/?#]+)/);
          if (!m) return;
          if (eventiAttivi.indexOf(m[1]) === -1) {
            a.replaceWith.apply(a, Array.from(a.childNodes));
            return;
          }
          // I minuti di auto solo al primo link di ogni evento (gli eventi a San Vito non li hanno)
          var minuti = minutiEventi[m[1]];
          if (!minuti || giaIndicati[m[1]]) return;
          giaIndicati[m[1]] = true;
          var span = document.createElement('span');
          span.className = 'minuti-auto';
          span.title = etichettaMinuti.replace('{n}', minuti);
          span.textContent = ' (🚗 ' + minuti + ' min)';
          a.after(span);
        });
      </script>
    )
  }
  <script is:inline>
    // Video di Facebook "clicca per caricare": l'iframe (e i cookie di Meta) arriva solo dopo il clic
    document.querySelectorAll('article .video-facebook button').forEach(function (b) {
      b.addEventListener('click', function () {
        var box = b.closest('.video-facebook');
        var f = document.createElement('iframe');
        f.src = box.dataset.src;
        f.title = box.dataset.title || '';
        f.allow = 'autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share';
        f.allowFullscreen = true;
        box.replaceChildren(f);
        box.classList.add('caricato');
      });
    });
  </script>

  <PhotoGallery items={galleryItems} numerata />
</Layout>

<style>
  /* Minuti di auto accanto ai link agli eventi, aggiunti dallo script: lo stile va reso globale */
  :global(.minuti-auto) {
    color: var(--color-muted);
    font-size: 0.9em;
    white-space: nowrap;
  }
  /* Video di Facebook incorporati nel testo (vedi lo script sopra) */
  article :global(.video-facebook) {
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0 0.5rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    background: #1f2328;
    color: #e6e6e6;
    border-radius: 8px;
    font-size: 0.9rem;
  }
  article :global(.video-facebook p) {
    margin: 0;
    max-width: 32rem;
  }
  article :global(.video-facebook a) {
    color: #fff;
  }
  article :global(.video-facebook button) {
    padding: 0.6rem 1.2rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  /* Reel verticali: stretti e centrati, senza occupare tutto lo schermo */
  article :global(.video-facebook.verticale) {
    aspect-ratio: 9 / 16;
    width: min(100%, 360px, 45vh);
    margin-left: auto;
    margin-right: auto;
  }
  article :global(.video-facebook.caricato) {
    padding: 0;
    background: #000;
  }
  article :global(.video-facebook iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 8px;
  }
  .avviso {
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  /* Nelle "Storie in sanvitese" la citazione è la poesia in dialetto */
  .poesia :global(blockquote) {
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1.5rem;
    background: #f2eee2;
    border-left: 4px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .poesia :global(blockquote h3) {
    margin: 0 0 1rem;
    font-style: normal;
    font-size: 1.2rem;
  }
  .poesia :global(blockquote p:first-of-type::before) {
    content: '«';
  }
  .poesia :global(blockquote p:last-of-type::after) {
    content: '»';
  }
  .poesia :global(blockquote footer) {
    margin-top: 1rem;
    text-align: right;
    font-style: normal;
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  /* L'immagine con il testo originale della poesia */
  .poesia :global(img) {
    border: 1px solid #d4d4d4;
  }

  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .articolo-image {
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 500;
    object-fit: cover;
  }
  .articolo-image-intera {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 8px;
  }
  /* Copertine verticali: al massimo tre quarti dello schermo, così il testo si vede subito */
  .articolo-image-intera.bassa {
    width: auto;
    max-height: 75vh;
  }
</style>

