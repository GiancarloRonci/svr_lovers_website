---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { formatEventDate } from '../../lib/eventDate';
import { tagClass } from '../../lib/eventCategory';
import { formatDriveTime } from '../../lib/driveTime';
import { getLastModified, formatLastModified } from '../../lib/lastModified';

export async function getStaticPaths() {
  const eventi = await getCollection('eventi');
  return eventi.map((e) => ({ params: { id: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { title, description, dataInizio, dataFine, luogo, minutiAuto, tipologiaEvento, immagine, galleria } = entry.data;
const distanza = formatDriveTime(minutiAuto, 'it');
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);
---

<Layout title={title} description={description}>
  <p><a href={withBase('eventi/')}>&larr; Tutti gli eventi</a></p>
  {tipologiaEvento && <p><span class={tagClass(tipologiaEvento)}>{tipologiaEvento}</span></p>}
  <h1>{title}</h1>
  <p class="meta">{formatEventDate(dataInizio, dataFine, 'it-IT')}</p>
  {luogo && <p class="luogo">📍 {luogo}{distanza && <span class="distanza"> · 🚗 {distanza}</span>}</p>}
  {lastModified && <p class="aggiornato">Ultimo aggiornamento: {formatLastModified(lastModified, 'it-IT')}</p>}

  {/* Le immagini degli eventi sono spesso locandine verticali: si mostrano intere, senza ritaglio */}
  {immagine && <Image class="evento-image" src={immagine} alt={title} width={900} />}

  <article>
    <Content />
  </article>

  {
    galleria && galleria.length > 0 && (
      <section class="gallery">
        {galleria.map((img) => (
          <Image src={img} alt={title} width={400} height={300} />
        ))}
      </section>
    )
  }
</Layout>

<style>
  .evento-image {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 8px;
  }
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }
  .luogo {
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0.25rem 0 1rem;
  }
  .distanza {
    font-weight: 400;
    color: var(--color-muted);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
</style>
