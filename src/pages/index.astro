---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const heroImages = import.meta.glob<{ default: ImageMetadata }>('../assets/hero.*', {
  eager: true,
});
const heroImage = Object.values(heroImages)[0]?.default;

const percorsi = (await getCollection('percorsi')).slice(0, 3);
const eventi = (await getCollection('eventi'))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);
---

<Layout title="Home">
  <section class="hero">
    {
      heroImage ? (
        <Image class="hero-image" src={heroImage} alt="Il paese" width={1600} height={700} />
      ) : (
        <div class="hero-placeholder">
          Aggiungi una foto di copertina in <code>src/assets/hero.jpg</code>
        </div>
      )
    }
    <h1>Benvenuti a [Nome del Paese]</h1>
    <p>
      Storia, luoghi, percorsi di trekking urbano e naturalistico, eventi e vita
      dell'associazione culturale: tutto quello che rende speciale il nostro paese.
    </p>
  </section>

  <section>
    <h2>Percorsi in evidenza</h2>
    <div class="card-grid">
      {
        percorsi.map((p) => (
          <Card
            href={withBase(`percorsi/${p.id}/`)}
            title={p.data.title}
            description={p.data.description}
            tag={p.data.tipo}
            image={p.data.immagine}
          />
        ))
      }
    </div>
  </section>

  <section>
    <h2>Ultimi eventi e feste</h2>
    <div class="card-grid">
      {
        eventi.map((e) => (
          <Card
            href={withBase(`eventi/${e.id}/`)}
            title={e.data.title}
            description={e.data.description}
            image={e.data.immagine}
          />
        ))
      }
    </div>
  </section>

  <style>
    .hero {
      padding: 2rem 0 1rem;
    }
    .hero-image {
      width: 100%;
      max-height: 420px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }
    .hero-placeholder {
      width: 100%;
      height: 220px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1rem;
      margin-bottom: 1.5rem;
      border: 2px dashed var(--color-border);
      border-radius: 12px;
      color: var(--color-muted);
      background: #fff;
    }
    .hero p {
      max-width: 60ch;
      color: var(--color-muted);
      font-size: 1.05rem;
    }
  </style>
</Layout>
