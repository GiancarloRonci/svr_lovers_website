---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const heroImages = import.meta.glob<{ default: ImageMetadata }>('../assets/hero.*', {
  eager: true,
});
const heroImage = Object.values(heroImages)[0]?.default;

const percorsi = (await getCollection('percorsi')).slice(0, 3);
const eventi = (await getCollection('eventi'))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);
---

<Layout title="Home">
  <section class="hero">
    {
      heroImage ? (
        <Image class="hero-image" src={heroImage} alt="Il paese" width={1600} height={700} />
      ) : (
        <div class="hero-placeholder">
          Aggiungi una foto di copertina in <code>src/assets/hero.jpg</code>
        </div>
      )
    }
    <h1>🌿 SANVITOROMANO.LOVERS</h1>
    <p class="hero-subtitle">Una community per raccontare e far conoscere San Vito Romano ❤️</p>
    <p>
      sanvitoromano.lovers nasce con un obiettivo semplice: far conoscere San Vito
      Romano il più possibile, raccontandolo attraverso le persone che lo vivono, i
      suoi luoghi, la sua storia e le sue tradizioni.
    </p>
    <p>
      🏘️ Un paese non è fatto soltanto di strade, piazze e monumenti. È fatto di
      ricordi, tradizioni, natura, cultura, storie e persone. Ed è proprio tutto
      questo che vogliamo raccogliere e condividere attraverso la nostra community
      online.
    </p>
    <p>
      L'idea è quella di costruire, poco alla volta, una grande vetrina digitale di
      San Vito Romano, aperta a tutti: a chi ci vive, a chi ci è cresciuto, a chi è
      lontano ma continua a sentirlo nel cuore e anche a chi potrebbe scoprirlo per
      la prima volta grazie ai social.
    </p>
    <p>
      👉 Più siamo, più possiamo raccontare San Vito.<br />
      👉 Più condividiamo, più possiamo farlo conoscere.
    </p>
    <p class="hero-subtitle">Seguiteci e partecipate alla community! ❤️</p>
    <ul class="social-links">
      <li>
        🔵 <a href="https://www.facebook.com/groups/sanvitoromano.lovers" target="_blank" rel="noopener noreferrer">Facebook</a>
      </li>
      <li>
        📸 <a href="https://www.instagram.com/sanvitoromano.lovers/" target="_blank" rel="noopener noreferrer">Instagram</a>
      </li>
      <li>
        🎵 <a href="https://www.tiktok.com/@sanvitoromano.lovers" target="_blank" rel="noopener noreferrer">TikTok</a>
      </li>
    </ul>
  </section>

  <section>
    <h2>Percorsi in evidenza</h2>
    <div class="card-grid">
      {
        percorsi.map((p) => (
          <Card
            href={withBase(`percorsi/${p.id}/`)}
            title={p.data.title}
            description={p.data.description}
            tag={p.data.tipo}
            image={p.data.immagine}
          />
        ))
      }
    </div>
  </section>

  <section>
    <h2>Ultimi eventi e feste</h2>
    <div class="card-grid">
      {
        eventi.map((e) => (
          <Card
            href={withBase(`eventi/${e.id}/`)}
            title={e.data.title}
            description={e.data.description}
            image={e.data.immagine}
          />
        ))
      }
    </div>
  </section>

  <style>
    .hero {
      padding: 2rem 0 1rem;
    }
    .hero-image {
      width: 100%;
      max-height: 420px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }
    .hero-placeholder {
      width: 100%;
      height: 220px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1rem;
      margin-bottom: 1.5rem;
      border: 2px dashed var(--color-border);
      border-radius: 12px;
      color: var(--color-muted);
      background: #fff;
    }
    .hero p {
      max-width: 60ch;
      color: var(--color-muted);
      font-size: 1.05rem;
    }
    .hero-subtitle {
      font-weight: 600;
      color: var(--color-text) !important;
      font-size: 1.15rem !important;
    }
    .social-links {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      padding: 0;
      margin: 0.5rem 0 0;
    }
    .social-links a {
      color: var(--color-text);
      font-weight: 600;
      text-decoration: underline;
    }
  </style>
</Layout>
