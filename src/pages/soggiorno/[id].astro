---
import Layout from '../../layouts/Layout.astro';
import TrailMap from '../../components/TrailMap.astro';
import { Image } from 'astro:assets';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { resolveGalleria } from '../../lib/gallery';
import { getLastModified, formatLastModified } from '../../lib/lastModified';

export async function getStaticPaths() {
  const strutture = await getCollection('soggiorno');
  return strutture.map((s) => ({ params: { id: s.id }, props: { entry: s } }));
}

const { entry } = Astro.props;
const { title, description, immagine, galleria, indirizzo, telefono, sito, coordinate } = entry.data;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);

const galleryItems = (await resolveGalleria(galleria, title)).map((item, i) => ({
  ...item,
  name: `Foto ${i + 1}`,
}));
---

<Layout title={title} description={description}>
  <a data-pagefind-ignore href={withBase('soggiorno/')}>&larr; Dove Soggiornare</a>
  <h1>{title}</h1>
  {lastModified && <p class="aggiornato">Ultimo aggiornamento: {formatLastModified(lastModified, 'it-IT')}</p>}

  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}

  {(indirizzo || telefono || sito) && (
    <ul class="contatti">
      {indirizzo && <li>📍 {indirizzo}</li>}
      {telefono && <li>📞 <a href={`tel:${telefono}`}>{telefono}</a></li>}
      {sito && <li>🔗 <a href={sito} target="_blank" rel="noopener noreferrer">{sito}</a></li>}
    </ul>
  )}

  {coordinate && (
    <>
      <h2>Dove si trova</h2>
      <TrailMap partenza={coordinate} />
    </>
  )}

  <article>
    <Content />
  </article>

  <PhotoGallery items={galleryItems} numerata />
</Layout>

<style>
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .contatti {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
</style>

