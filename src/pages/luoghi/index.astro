---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';
import { byInsertionDesc } from '../../lib/insertionOrder';

const luoghi = (await getCollection('luoghi')).sort(byInsertionDesc);
const isSanVito = (l: (typeof luoghi)[number]) => l.data.comune === 'San Vito Romano';
const sections = [
  { id: 'a-san-vito', title: 'A San Vito', items: luoghi.filter(isSanVito) },
  { id: 'dintorni', title: 'Dintorni', items: luoghi.filter((l) => !isSanVito(l)) },
].filter((s) => s.items.length > 0);
---

<Layout title="Luoghi" description="Le principali località e attrazioni del paese.">
  <h1>Luoghi</h1>
  <p class="meta">Le piazze, i monumenti e gli angoli da non perdere.</p>

  {
    sections.map((section) => (
      <section id={section.id}>
        <h2>{section.title}</h2>
        <div class="card-grid">
          {section.items.map((l) => (
            <Card
              href={withBase(`luoghi/${l.id}/`)}
              title={l.data.title}
              description={l.data.description}
              image={l.data.immagine}
              luogo={l.data.comune}
            />
          ))}
        </div>
      </section>
    ))
  }
</Layout>
