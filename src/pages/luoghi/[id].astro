---
import Layout from '../../layouts/Layout.astro';
import TrailMap from '../../components/TrailMap.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const luoghi = await getCollection('luoghi');
  return luoghi.map((l) => ({ params: { id: l.id }, props: { entry: l } }));
}

const { entry } = Astro.props;
const { title, description, immagine, coordinate } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={description}>
  <a href="/luoghi/">&larr; Tutti i luoghi</a>
  <h1>{title}</h1>
  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}
  {coordinate && <TrailMap partenza={coordinate} />}
  <article>
    <Content />
  </article>
</Layout>
