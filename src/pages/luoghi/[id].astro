---
import Layout from '../../layouts/Layout.astro';
import TrailMap from '../../components/TrailMap.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const luoghi = await getCollection('luoghi');
  return luoghi.map((l) => ({ params: { id: l.id }, props: { entry: l } }));
}

const { entry } = Astro.props;
const { title, description, immagine, galleria, coordinate } = entry.data;
const { Content } = await render(entry);

const galleriaFull = galleria
  ? await Promise.all(galleria.map((img) => getImage({ src: img, width: 1400 })))
  : [];
---

<Layout title={title} description={description}>
  <a href={withBase('luoghi/')}>&larr; Tutti i luoghi</a>
  <h1>{title}</h1>
  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}
  {coordinate && <TrailMap partenza={coordinate} />}
  <article>
    <Content />
  </article>

  {
    galleria && galleria.length > 0 && (
      <section class="gallery">
        {galleria.map((img, i) => (
          <button type="button" class="gallery-item" data-full={galleriaFull[i].src}>
            <Image src={img} alt={`${title} - foto ${i + 1}`} width={400} height={300} />
          </button>
        ))}
      </section>
    )
  }

  <div class="lightbox" id="lightbox" hidden>
    <button type="button" class="lightbox-close" aria-label="Chiudi">&times;</button>
    <button type="button" class="lightbox-prev" aria-label="Foto precedente">&larr;</button>
    <img class="lightbox-img" alt="" />
    <button type="button" class="lightbox-next" aria-label="Foto successiva">&rarr;</button>
  </div>
</Layout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .gallery-item {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
  }
  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  const gallery = document.querySelector('.gallery');
  const lightbox = document.getElementById('lightbox');

  if (gallery && lightbox) {
    const items = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery-item'));
    const img = lightbox.querySelector('.lightbox-img') as HTMLImageElement;
    let current = 0;

    const open = (i: number) => {
      current = i;
      img.src = items[i].dataset.full ?? '';
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    };
    const move = (delta: number) => {
      current = (current + delta + items.length) % items.length;
      img.src = items[current].dataset.full ?? '';
    };

    items.forEach((item, i) => item.addEventListener('click', () => open(i)));
    lightbox.querySelector('.lightbox-close')?.addEventListener('click', close);
    lightbox.querySelector('.lightbox-prev')?.addEventListener('click', () => move(-1));
    lightbox.querySelector('.lightbox-next')?.addEventListener('click', () => move(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') move(-1);
      if (e.key === 'ArrowRight') move(1);
    });
  }
</script>
