---
import Layout from '../../layouts/Layout.astro';
import TrailMap from '../../components/TrailMap.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { formatDriveTime } from '../../lib/driveTime';
import { resolveGalleria } from '../../lib/gallery';
import { formatCredit } from '../../lib/photoCredit';
import { getLastModified, formatLastModified } from '../../lib/lastModified';

export async function getStaticPaths() {
  const luoghi = await getCollection('luoghi');
  return luoghi.map((l) => ({ params: { id: l.id }, props: { entry: l } }));
}

const { entry } = Astro.props;
const { title, description, comune, minutiAuto, immagine, immagineAutore, immagineLicenza, galleria, coordinate } = entry.data;
const distanza = formatDriveTime(minutiAuto, 'it');
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);

const galleryItems = (await resolveGalleria(galleria, title)).map((item, i) => ({
  ...item,
  name: `Foto ${i + 1}`,
}));
---

<Layout title={title} description={description}>
  <a data-pagefind-ignore href={withBase('luoghi/')}>&larr; Tutti i luoghi</a>
  <h1>{title}</h1>
  <p class="comune">📍 {comune}{distanza && <span class="distanza"> · 🚗 {distanza}</span>}</p>
  {lastModified && <p class="aggiornato">Ultimo aggiornamento: {formatLastModified(lastModified, 'it-IT')}</p>}
  {
    immagine && (
      <div class="cover">
        <Image class:list={['luogo-image', entry.id]} src={immagine} alt={title} width={900} height={500} />
        <span class="cover-credit">{formatCredit(immagineAutore, immagineLicenza)}</span>
      </div>
    )
  }
  {
    coordinate && (
      <>
        <h2>Dove si trova</h2>
        <TrailMap partenza={coordinate} />
      </>
    )
  }
  <article>
    <Content />
  </article>
  <p class="segnalazioni">
    Hai trovato un'inesattezza in questo testo, o vuoi aggiungere qualche dettaglio? Scrivici
    a <a href="mailto:info@sanvitoromanolovers.org">info@sanvitoromanolovers.org</a>: è anche grazie alle vostre
    segnalazioni che il sito può migliorare sempre di più.
  </p>

  <PhotoGallery items={galleryItems} numerata />
</Layout>

<style>
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.75rem;
  }

  .comune {
    font-weight: 600;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .distanza {
    font-weight: 400;
  }

  .segnalazioni {
    font-size: 0.9rem;
    color: var(--color-muted);
    font-style: italic;
  }

  .cover {
    position: relative;
  }
  .cover-credit {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.75rem;
  }

  .luogo-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 500;
    object-fit: cover;
    object-position: center 65%;
  }
</style>

