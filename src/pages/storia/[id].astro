---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articoli = await getCollection('storia');
  return articoli.map((a) => ({ params: { id: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { title, description, immagine } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={description}>
  <a href="/storia/">&larr; Tutta la storia</a>
  <h1>{title}</h1>
  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}
  <article>
    <Content />
  </article>
</Layout>
