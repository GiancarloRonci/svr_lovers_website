---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const news = await getCollection('newsEn');
  return news.map((n) => ({ params: { id: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props;
const { title, description, data, immagine } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={description}>
  <a href={withBase('en/news/')}>&larr; All news</a>
  <h1>{title}</h1>
  <p class="meta">{data.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>

  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}

  <article>
    <Content />
  </article>
</Layout>
