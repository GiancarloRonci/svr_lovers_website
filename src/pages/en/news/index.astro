---
import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/url';

const news = (await getCollection('newsEn')).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf()
);
---

<Layout title="News" description="The community's latest news.">
  <h1>News</h1>
  <p class="meta">All the community's news and updates.</p>

  <div class="card-grid">
    {
      news.map((n) => (
        <Card
          href={withBase(`en/news/${n.id}/`)}
          title={n.data.title}
          description={n.data.description}
          meta={n.data.data.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          image={n.data.immagine}
        />
      ))
    }
  </div>
</Layout>
