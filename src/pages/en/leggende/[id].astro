---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';
import { getLastModified, formatLastModified } from '../../../lib/lastModified';

export async function getStaticPaths() {
  const leggende = await getCollection('leggendeEn');
  return leggende.map((l) => ({ params: { id: l.id }, props: { entry: l } }));
}

const { entry } = Astro.props;
const { title, description, immagine } = entry.data;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);
---

<Layout title={title} description={description}>
  <a href={withBase('en/leggende/')}>&larr; All legends</a>
  <h1>{title}</h1>
  {lastModified && <p class="aggiornato">Last updated: {formatLastModified(lastModified, 'en-GB')}</p>}
  {immagine && <Image class="luogo-image" src={immagine} alt={title} width={900} />}
  <article>
    <Content />
  </article>
</Layout>

<style>
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .luogo-image {
    width: 100%;
    height: auto;
  }
</style>
