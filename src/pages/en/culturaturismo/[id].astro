---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';
import { getLastModified, formatLastModified } from '../../../lib/lastModified';

export async function getStaticPaths() {
  const attivita = await getCollection('associazioneEn');
  return attivita.map((a) => ({ params: { id: a.id }, props: { entry: a } }));
}

const etichette: Record<string, string> = {
  scacchi: 'Chess',
  dama: 'Checkers',
  bocce: 'Bocce',
  'proiezione-film': 'Film Screenings',
  'proiezione-partite': 'Match Screenings',
  'orientamento-turistico': 'Tourist Guidance',
  'percorsi-naturalistici': 'Nature Trails',
  'concorsi-fotografici': 'Photo Contest',
  altro: 'Other activities',
};

const { entry } = Astro.props;
const { title, description, categoria, frequenza, immagine, moduloTally } = entry.data;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);
const haRegolamento = (await getCollection('regolamentiEn')).some((r) => r.id === entry.id);
const grazieUrl = withBase(`en/culturaturismo/${entry.id}/grazie/`);
---

<Layout title={title} description={description}>
  <a href={withBase('en/culturaturismo/')}>&larr; All activities</a>
  <span class="tag">{etichette[categoria]}</span>
  <h1>{title}</h1>
  {frequenza && <p class="meta">{frequenza}</p>}
  {lastModified && <p class="aggiornato">Last updated: {formatLastModified(lastModified, 'en-GB')}</p>}

  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}

  <article>
    <Content />
  </article>

  {
    haRegolamento && (
      <p>
        <a href={withBase(`en/culturaturismo/${entry.id}/regolamento/`)}>Read the contest rules &rarr;</a>
      </p>
    )
  }

  {
    moduloTally && (
      <iframe
        id="partecipa"
        data-tally-src={`https://tally.so/embed/${moduloTally}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
        loading="lazy"
        width="100%"
        height="636"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title={`Entry form - ${title}`}
      />
    )
  }
  {
    moduloTally && (
      <script is:inline>
        var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
      </script>
    )
  }
  {
    moduloTally && (
      <script is:inline define:vars={{ grazieUrl }}>
        // A invio completato Tally avvisa la pagina: si passa alla pagina di ringraziamento
        window.addEventListener('message', function (e) {
          if (e.origin !== 'https://tally.so') return;
          if (typeof e.data !== 'string' || e.data.indexOf('Tally.FormSubmitted') === -1) return;
          try {
            sessionStorage.removeItem('svr-contest-nome');
            var campi = JSON.parse(e.data).payload.fields || [];
            for (var i = 0; i < campi.length; i++) {
              var valore = campi[i].answer && campi[i].answer.value;
              if (/^(nome e cognome|nome|full name|name)$/i.test((campi[i].title || '').trim()) && typeof valore === 'string' && valore.trim()) {
                sessionStorage.setItem('svr-contest-nome', valore.trim());
                break;
              }
            }
          } catch (err) {}
          window.location.href = grazieUrl;
        });
      </script>
    )
  }
</Layout>

<style>
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }
</style>
