---
import Layout from '../../../layouts/Layout.astro';
import TrailMap from '../../../components/TrailMap.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const percorsi = await getCollection('percorsiEn');
  return percorsi.map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}

const tipoLabels: Record<string, string> = {
  urbano: 'Urban',
  naturalistico: 'Nature',
};
const difficoltaLabels: Record<string, string> = {
  facile: 'Easy',
  medio: 'Medium',
  difficile: 'Hard',
};

const { entry } = Astro.props;
const { title, description, tipo, difficolta, lunghezzaKm, durata, dislivello, immagine, gpx, partenza } =
  entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={description}>
  <a href={withBase('en/percorsi/')}>&larr; All trails</a>
  <h1>{title}</h1>
  <p class="meta">
    {tipoLabels[tipo]} · {difficoltaLabels[difficolta]} · {lunghezzaKm} km · {durata}
    {dislivello && ` · elevation gain ${dislivello}`}
  </p>

  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}

  {(gpx || partenza) && <TrailMap gpx={gpx} partenza={partenza} />}

  <article>
    <Content />
  </article>
</Layout>
