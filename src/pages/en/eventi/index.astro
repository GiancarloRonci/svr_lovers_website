---
import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/url';

const oggi = new Date();
oggi.setHours(0, 0, 0, 0);

const eventi = (await getCollection('eventiEn'))
  .filter((e) => e.data.data.valueOf() >= oggi.valueOf())
  .sort((a, b) => a.data.data.valueOf() - b.data.data.valueOf());
---

<Layout title="Events & Festivals" description="Memories of the town's events and festivals.">
  <h1>Events &amp; Festivals</h1>
  <p class="meta">Memories and photos of the community's festivals and initiatives.</p>

  <div class="card-list">
    {
      eventi.map((e) => (
        <Card
          href={withBase(`en/eventi/${e.id}/`)}
          title={e.data.title}
          tag={e.data.tipologiaEvento}
          description={e.data.data.toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
          luogo={e.data.luogo}
          image={e.data.immagine}
        />
      ))
    }
  </div>
</Layout>
