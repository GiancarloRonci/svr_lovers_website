---
import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/url';
import { formatEventDate } from '../../../lib/eventDate';
import { tagClass } from '../../../lib/eventCategory';

const oggi = new Date();
oggi.setHours(0, 0, 0, 0);

const eventi = (await getCollection('eventiEn'))
  .filter((e) => (e.data.dataFine ?? e.data.dataInizio).valueOf() >= oggi.valueOf())
  .sort((a, b) => a.data.dataInizio.valueOf() - b.data.dataInizio.valueOf());

const aSanVito = (e: (typeof eventi)[number]) => e.data.luogo?.includes('San Vito Romano') ?? false;
const sezioni = [
  { titolo: 'In San Vito Romano', eventi: eventi.filter(aSanVito) },
  { titolo: 'In the surrounding area', eventi: eventi.filter((e) => !aSanVito(e)) },
].filter((s) => s.eventi.length > 0);
---

<Layout
  title="Events & Festivals"
  description="Festivals, food fairs and events in San Vito Romano and the surrounding area."
>
  <h1>Events &amp; Festivals</h1>
  <p class="meta">Festivals, food fairs and events in San Vito Romano and the surrounding area.</p>

  {
    sezioni.map((s) => (
      <section>
        {sezioni.length > 1 && <h2>{s.titolo}</h2>}
        <div class="card-list">
          {s.eventi.map((e) => (
            <Card
              href={withBase(`en/eventi/${e.id}/`)}
              title={e.data.title}
              tag={e.data.tipologiaEvento}
              tagClass={tagClass(e.data.tipologiaEvento)}
              description={formatEventDate(e.data.dataInizio, e.data.dataFine, 'en-GB')}
              luogo={e.data.luogo}
              image={e.data.immagine}
            />
          ))}
        </div>
      </section>
    ))
  }
</Layout>
