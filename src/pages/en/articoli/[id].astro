---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PhotoGallery from '../../../components/PhotoGallery.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';
import { resolveGalleria } from '../../../lib/gallery';
import { getLastModified, formatLastModified } from '../../../lib/lastModified';
import { weekendDatesFromSlug } from '../../../lib/weekend';
import Meteo3b from '../../../components/Meteo3b.astro';

export async function getStaticPaths() {
  const articoli = await getCollection('articoliEn');
  return articoli.map((a) => ({ params: { id: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { title, description, data, autore, categoria, immagine, immagineIntera: immagineInteraFlag, galleria } = entry.data;
// Nei "Viaggi nel tempo" e nelle "Storie in sanvitese" l'immagine è il cuore dell'articolo: si mostra intera, senza ritaglio (o quando lo chiede `immagineIntera`)
const immagineIntera = categoria === 'viaggi-nel-tempo' || categoria === 'storie-in-sanvitese' || immagineInteraFlag === true;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);
// Nei consigli del weekend i link agli eventi già rimossi dalla collection diventano testo semplice
const eventiAttivi = categoria === 'weekend' ? (await getCollection('eventiEn')).map((e) => e.id) : null;
const weekend = categoria === 'weekend' ? weekendDatesFromSlug(entry.id) : null;

const galleryItems = (await resolveGalleria(galleria, title, 0, 'photo')).map((item, i) => ({
  ...item,
  name: `Photo ${i + 1}`,
}));
---

<Layout title={title} description={description}>
  <a data-pagefind-ignore href={withBase('en/articoli/')}>&larr; All articles</a>
  <h1>{title}</h1>
  <p class="meta">
    {data && <>{data.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</>}
    {data && autore && <> · </>}
    {autore && <>{autore}</>}
  </p>
  {lastModified && <p class="aggiornato">Last updated: {formatLastModified(lastModified, 'en-GB')}</p>}
  {immagine && !immagineIntera && <Image class="articolo-image" src={immagine} alt={title} width={900} height={500} />}
  {immagine && immagineIntera && <Image class="articolo-image-intera" src={immagine} alt={title} />}
  {
    categoria === 'weekend' && (
      <>
      <p class="avviso">
        <strong>Pick what suits you.</strong> This article sums up all the main events of the
        weekend, but there's no need to attend them all: choose the ones you like best, based on
        your tastes and the time you have available.
      </p>
      <p class="avviso">
        <strong>Always check before you set off.</strong> Make sure with the organisers or the
        official sources that the event is confirmed and that times and details haven't changed:
        programmes can be changed or cancelled at the last minute.
      </p>
      </>
    )
  }
  {weekend && <Meteo3b lang="en" weekendFine={weekend.fine} />}
  <article class:list={{ poesia: categoria === 'storie-in-sanvitese' }}>
    <Content />
  </article>
  {
    eventiAttivi && (
      <script is:inline define:vars={{ eventiAttivi }}>
        document.querySelectorAll('article a[href*="/eventi/"]').forEach(function (a) {
          var m = a.getAttribute('href').match(/\/eventi\/([^/?#]+)/);
          if (m && eventiAttivi.indexOf(m[1]) === -1) a.replaceWith.apply(a, Array.from(a.childNodes));
        });
      </script>
    )
  }

  <PhotoGallery items={galleryItems} lang="en" numerata />
</Layout>

<style>
  .avviso {
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  /* Nelle "Storie in sanvitese" la citazione è la poesia in dialetto */
  .poesia :global(blockquote) {
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1.5rem;
    background: #f2eee2;
    border-left: 4px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .poesia :global(blockquote h3) {
    margin: 0 0 1rem;
    font-style: normal;
    font-size: 1.2rem;
  }
  .poesia :global(blockquote p:first-of-type::before) {
    content: '«';
  }
  .poesia :global(blockquote p:last-of-type::after) {
    content: '»';
  }
  .poesia :global(blockquote footer) {
    margin-top: 1rem;
    text-align: right;
    font-style: normal;
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  /* L'immagine con il testo originale della poesia */
  .poesia :global(img) {
    border: 1px solid #d4d4d4;
  }

  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .articolo-image {
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 500;
    object-fit: cover;
  }
  .articolo-image-intera {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 8px;
  }
</style>

