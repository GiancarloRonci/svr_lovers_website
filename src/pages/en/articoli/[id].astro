---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';
import { getLastModified, formatLastModified } from '../../../lib/lastModified';

export async function getStaticPaths() {
  const articoli = await getCollection('articoliEn');
  return articoli.map((a) => ({ params: { id: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { title, description, data, autore, immagine } = entry.data;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);
---

<Layout title={title} description={description}>
  <a href={withBase('en/articoli/')}>&larr; All articles</a>
  <h1>{title}</h1>
  <p class="meta">
    {data && <>{data.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</>}
    {data && autore && <> · </>}
    {autore && <>{autore}</>}
  </p>
  {lastModified && <p class="aggiornato">Last updated: {formatLastModified(lastModified, 'en-GB')}</p>}
  {immagine && <Image class="articolo-image" src={immagine} alt={title} width={900} height={500} />}
  <article>
    <Content />
  </article>
</Layout>

<style>
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .articolo-image {
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 500;
    object-fit: cover;
  }
</style>
