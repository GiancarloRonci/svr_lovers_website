---
import Layout from '../../../layouts/Layout.astro';
import TrailMap from '../../../components/TrailMap.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const luoghi = await getCollection('luoghiEn');
  return luoghi.map((l) => ({ params: { id: l.id }, props: { entry: l } }));
}

const { entry } = Astro.props;
const { title, description, immagine, galleria, coordinate } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={description}>
  <a href={withBase('en/luoghi/')}>&larr; All places</a>
  <h1>{title}</h1>
  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}
  {coordinate && <TrailMap partenza={coordinate} />}
  <article>
    <Content />
  </article>

  {
    galleria && galleria.length > 0 && (
      <section class="gallery">
        {galleria.map((img) => (
          <Image src={img} alt={title} width={400} height={300} />
        ))}
      </section>
    )
  }
</Layout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
</style>
