---
import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/url';

const itinerari = (await getCollection('cosaFareEn')).sort((a, b) => a.data.giorniTotali - b.data.giorniTotali);
---

<Layout title="What to Do" description="Suggested itineraries for a stay in San Vito Romano.">
  <h1>What to Do</h1>
  <p class="meta">Itineraries with suggested times for a 3, 5, 7 or 15 day stay.</p>
  <p class="avviso">
    <strong>Before you set off, always check for yourself.</strong> The itineraries are only
    suggestions: everyone must personally double-check with the official sources that each place can
    actually be visited on the chosen day and at the chosen time. The SVR Lovers site accepts no
    responsibility for any inconvenience caused by inaccurate information or by changes to opening
    days and times.
  </p>
  <p class="avviso">
    <strong>Adapt the itinerary to your own pace.</strong> Feel free to change and cut down the
    stops of each day: there is no need to get stressed or to go beyond your own physical abilities
    and habits.
  </p>

  <div class="card-grid">
    {
      itinerari.map((i) => (
        <Card
          href={withBase(`en/cosa-fare/${i.id}/`)}
          title={i.data.title}
          description={i.data.description}
        />
      ))
    }
  </div>
</Layout>

<style>
  .avviso {
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
