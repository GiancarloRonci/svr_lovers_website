---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/url';
import { getLastModified, formatLastModified } from '../../../lib/lastModified';

export async function getStaticPaths() {
  const itinerari = await getCollection('cosaFareEn');
  return itinerari.map((i) => ({ params: { id: i.id }, props: { entry: i } }));
}

const { entry } = Astro.props;
const { title, description, giorniTotali, giorni } = entry.data;
const lastModified = getLastModified(entry.filePath);
---

<Layout title={title} description={description}>
  <a href={withBase('en/cosa-fare/')}>&larr; What to Do</a>
  <h1>{title}</h1>
  <p class="meta">{giorniTotali} days · {description}</p>
  {lastModified && <p class="aggiornato">Last updated: {formatLastModified(lastModified, 'en-GB')}</p>}
  <p class="avviso">
    <strong>Before you set off, always check for yourself.</strong> The itineraries are only
    suggestions: everyone must personally double-check with the official sources that each place can
    actually be visited on the chosen day and at the chosen time. The SVR Lovers site accepts no
    responsibility for any inconvenience caused by inaccurate information or by changes to opening
    days and times.
  </p>
  <p class="avviso">
    <strong>Adapt the itinerary to your own pace.</strong> Feel free to change and cut down the
    stops of each day: there is no need to get stressed or to go beyond your own physical abilities
    and habits.
  </p>

  {
    giorni.map((giorno, i) => (
      <section class="giorno">
        <h2>{giorno.titolo ?? `Day ${i + 1}`}</h2>
        <ol class="tappe">
          {giorno.tappe.map((tappa) => (
            <li class="tappa">
              <span class="orario">
                {tappa.oraInizio}
                {tappa.oraFine && `–${tappa.oraFine}`}
              </span>
              <span class="dettaglio">
                <strong>{tappa.attivita}</strong>
                {tappa.descrizione && <p>{tappa.descrizione}</p>}
                {[tappa.link ?? []].flat().map((link) => (
                  <p>
                    <a href={withBase(link.href)}>{link.testo}</a>
                  </p>
                ))}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Layout>

<style>
  .avviso {
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .giorno {
    margin-top: 2rem;
  }

  .tappe {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .tappa {
    display: flex;
    gap: 1rem;
    padding: 0 0 1.25rem 1.25rem;
    border-left: 2px solid var(--color-accent);
  }

  .orario {
    flex: 0 0 auto;
    min-width: 6.5rem;
    font-weight: 700;
    color: var(--color-accent-dark);
  }

  .dettaglio p {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
