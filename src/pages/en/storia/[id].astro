---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';
import { getLastModified, formatLastModified } from '../../../lib/lastModified';

export async function getStaticPaths() {
  const articoli = await getCollection('storiaEn');
  return articoli.map((a) => ({ params: { id: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { title, description, immagine } = entry.data;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);
---

<Layout title={title} description={description}>
  <a href={withBase('en/storia/')}>&larr; All history</a>
  <h1>{title}</h1>
  {lastModified && <p class="aggiornato">Last updated: {formatLastModified(lastModified, 'en-GB')}</p>}
  {immagine && <Image src={immagine} alt={title} width={900} height={500} />}
  <article>
    <Content />
  </article>
  <p class="segnalazioni">
    Have you spotted an inaccuracy in this text, or would you like to add more details? Write to us at
    <a href="mailto:info@sanvitoromanolovers.org">info@sanvitoromanolovers.org</a>: your feedback is also what helps
    the site keep getting better.
  </p>
</Layout>

<style>
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .segnalazioni {
    font-size: 0.9rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
