---
import Layout from '../../layouts/Layout.astro';
import TrailMap from '../../components/TrailMap.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { resolveMappaFoto } from '../../lib/mappeFoto';
import { getLastModified, formatLastModified } from '../../lib/lastModified';

export async function getStaticPaths() {
  const mappe = await getCollection('mappeFoto');
  return mappe.map((m) => ({ params: { id: m.id }, props: { entry: m } }));
}

const { entry } = Astro.props;
const { title, description, foto } = entry.data;
const { Content } = await render(entry);
const lastModified = getLastModified(entry.filePath);

const risolte = await resolveMappaFoto(foto, 'it', title);
const punti = risolte.map(({ immagine, ...p }) => p);
const galleryItems = risolte.map((f) => ({
  immagine: f.immagine,
  full: f.full,
  alt: f.didascalia || f.name,
  caption: f.didascalia ?? '',
  credit: f.credit,
  name: f.name,
}));
---

<Layout title={title} description={description}>
  <a data-pagefind-ignore href={withBase('mappe-foto/')}>&larr; Tutte le mappe con foto</a>
  <h1>{title}</h1>
  <p class="meta">{punti.length} foto sulla mappa</p>
  {lastModified && <p class="aggiornato">Ultimo aggiornamento: {formatLastModified(lastModified, 'it-IT')}</p>}

  <article>
    <Content />
  </article>

  <TrailMap foto={punti} alta />

  <PhotoGallery items={galleryItems} />
</Layout>

<style>
  .aggiornato {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: -0.5rem;
  }
</style>
