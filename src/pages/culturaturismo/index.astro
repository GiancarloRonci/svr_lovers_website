---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
import cercasiStaff from '../../assets/culturaturismo/cercasi-staff.svg';
import { withBase } from '../../lib/url';
import { byInsertionDesc } from '../../lib/insertionOrder';

const attivita = await getCollection('associazione');
const viaggiNelTempo = (await getCollection('articoli'))
  .filter((a) => a.data.categoria === 'viaggi-nel-tempo')
  .sort(byInsertionDesc);
const weekend = (await getCollection('articoli'))
  .filter((a) => a.data.categoria === 'weekend')
  .sort(byInsertionDesc);
const storieInSanvitese = (await getCollection('articoli'))
  .filter((a) => a.data.categoria === 'storie-in-sanvitese')
  .sort(byInsertionDesc);

const etichette: Record<string, string> = {
  scacchi: 'Scacchi',
  dama: 'Dama',
  bocce: 'Bocce',
  'proiezione-film': 'Proiezione Film',
  'proiezione-partite': 'Proiezione Partite',
  'orientamento-turistico': 'Orientamento Turistico',
  'percorsi-naturalistici': 'Percorsi Naturalistici',
  'concorsi-fotografici': 'Contest Fotografico',
  'contest-letterario': 'Contest Letterario',
  'contest-musicale': 'Contest Musicale',
  'caccia-al-tesoro': 'Caccia al Tesoro',
  altro: 'Altre attività',
};

const categorie = ['scacchi', 'dama', 'bocce', 'proiezione-film', 'proiezione-partite', 'orientamento-turistico', 'percorsi-naturalistici', 'concorsi-fotografici', 'contest-letterario', 'contest-musicale', 'caccia-al-tesoro', 'altro'] as const;
---

<Layout cercabile={false}
  title="Cultura&Turismo"
  description="Le attività di Cultura&Turismo in paese: scacchi, dama, bocce e proiezioni insieme."
>
  <h1>Cultura&Turismo</h1>
  <p class="meta">
    Un punto di ritrovo per la comunità: tornei, sfide e serate condivise attorno alle nostre
    attività preferite.
  </p>
  <p>
    Stiamo cercando di promuovere, anche con l'aiuto di realtà locali consolidate, una serie di
    iniziative orientate alla cultura in genere e all'orientamento turistico. Seguiranno maggiori
    dettagli.
  </p>
  <p>
    <strong>
      A parte il Contest Fotografico, quelle che seguono sono soltanto idee: non sappiamo ancora
      con certezza se verranno realizzate, né quando.
    </strong>
  </p>
  <p>
    Per provare a realizzare le varie idee cercheremo una collaborazione anche con organizzazioni
    istituzionali.
  </p>
  <p>
    Cerchiamo collaboratori che ci aiutino a sviluppare queste idee: se vuoi darci una mano, <a href={withBase('contatti/')}>scrivici</a>.
  </p>

  {
    categorie.map((cat) => {
      const items = attivita.filter((a) => a.data.categoria === cat);
      if (items.length === 0) return null;
      // Un contest con il modulo di partecipazione (moduloTally) è aperto: lo mettiamo in evidenza
      const attivo = items.some((a) => a.data.moduloTally);
      return (
        <section id={cat} class={attivo ? 'iniziativa-attiva' : undefined}>
          <h2>
            {etichette[cat]}
            {attivo && <span class="stato-attivo"><span class="pallino" aria-hidden="true" />In corso</span>}
          </h2>
          <div class="card-grid">
            {items.map((a) => (
              <Card
                href={withBase(`culturaturismo/${a.id}/`)}
                title={a.data.title}
                description={a.data.frequenza ?? a.data.description}
                image={a.data.immagine ?? (cat === 'concorsi-fotografici' ? undefined : cercasiStaff)}
                invito={cat === 'concorsi-fotografici' ? (a.data.moduloTally ? 'Iscrizioni aperte: carica le tue foto e partecipa!' : undefined) : "Se vuoi curare questa parte, vieni a far parte dello staff di SanVitoRomano Lovers!"}
                nota={cat === 'concorsi-fotografici' ? undefined : 'Attività in fase di definizione: al momento non sappiamo ancora quando inizierà.'}
              >
                {a.data.moduloTally && <span class="badge-attivo"><span class="pallino" aria-hidden="true" />In corso · Partecipa</span>}
              </Card>
            ))}
          </div>
        </section>
      );
    })
  }

  {
    viaggiNelTempo.length > 0 && (
      <section id="viaggi-nel-tempo">
        <h2>Viaggi nel tempo</h2>
        <p>
          Articoli che ci riportano nella San Vito di una volta: un'immagine del passato ricreata
          con l'intelligenza artificiale e un testo che la racconta.
        </p>
        <div class="card-grid">
          {viaggiNelTempo.map((a) => (
            <Card
              href={withBase(`articoli/${a.id}/`)}
              title={a.data.title}
              description={a.data.description}
              meta={a.data.data?.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}
              image={a.data.immagine}
              imagePosition={a.data.copertinaPosizione}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    storieInSanvitese.length > 0 && (
      <section id="storie-in-sanvitese">
        <h2>Storie in sanvitese</h2>
        <p>
          Storie e poesie nel dialetto di San Vito Romano, ciascuna con un'immagine e una
          spiegazione in italiano.
        </p>
        <div class="card-grid">
          {storieInSanvitese.map((a) => (
            <Card
              href={withBase(`articoli/${a.id}/`)}
              title={a.data.title}
              description={a.data.description}
              meta={a.data.data?.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}
              image={a.data.immagine}
              imagePosition={a.data.copertinaPosizione}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    weekend.length > 0 && (
      <section id="weekend">
        <h2>Il weekend</h2>
        <p>
          I nostri consigli per il fine settimana: sagre, escursioni, concerti e appuntamenti a San
          Vito Romano e nei dintorni, scelti tra gli eventi in programma.
        </p>
        <div class="card-grid">
          {weekend.map((a) => (
            <Card
              href={withBase(`articoli/${a.id}/`)}
              title={a.data.title}
              description={a.data.description}
              meta={a.data.data?.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}
              image={a.data.immagine}
              imagePosition={a.data.copertinaPosizione}
            />
          ))}
        </div>
      </section>
    )
  }
</Layout>

<style>
  /* Le iniziative in corso (oggi il Contest Fotografico) si distinguono dalle semplici idee */
  .stato-attivo,
  .badge-attivo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #2e7d32;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .stato-attivo {
    margin-left: 0.6rem;
  }
  .badge-attivo {
    align-self: flex-start;
    margin: 0.9rem 1rem 0;
  }
  .pallino {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #b9f6ca;
    animation: pulsa 1.6s ease-out infinite;
  }
  .iniziativa-attiva :global(.card) {
    border: 2px solid #2e7d32;
    box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.45);
    animation: alone 2.4s ease-out infinite;
  }
  .iniziativa-attiva :global(.invito) {
    color: #2e7d32;
  }
  @keyframes pulsa {
    0% { box-shadow: 0 0 0 0 rgba(185, 246, 202, 0.9); }
    100% { box-shadow: 0 0 0 0.5rem rgba(185, 246, 202, 0); }
  }
  @keyframes alone {
    0% { box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.45); }
    70% { box-shadow: 0 0 0 0.7rem rgba(46, 125, 50, 0); }
    100% { box-shadow: 0 0 0 0 rgba(46, 125, 50, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pallino,
    .iniziativa-attiva :global(.card) {
      animation: none;
    }
  }
</style>
