---
// Previsioni meteo per San Vito Romano da Open-Meteo (gratuito, senza chiave, senza cookie).
// I dati si caricano nel browser del visitatore, così restano aggiornati anche se il sito non viene ripubblicato.
// Con `weekendInizio`/`weekendFine` (date ISO) i giorni del weekend sono evidenziati e, a weekend passato, il riquadro non si mostra.
interface Props {
  lang: 'it' | 'en';
  weekendInizio?: string;
  weekendFine?: string;
}

const { lang, weekendInizio, weekendFine } = Astro.props;
const t =
  lang === 'en'
    ? {
        heading: 'Weather in San Vito Romano',
        weekendNote: 'The weekend days are highlighted.',
        loading: 'Loading the forecast…',
        source: 'Forecast data',
      }
    : {
        heading: 'Meteo a San Vito Romano',
        weekendNote: 'In evidenza i giorni del weekend.',
        loading: 'Caricamento delle previsioni…',
        source: 'Dati delle previsioni',
      };
---

<section class="meteo" data-lang={lang} data-weekend-inizio={weekendInizio} data-weekend-fine={weekendFine}>
  <h2>{t.heading}</h2>
  {weekendInizio && <p class="meteo-nota">{t.weekendNote}</p>}
  <p class="meteo-stato">{t.loading}</p>
  <ol class="meteo-giorni" hidden></ol>
  <p class="meteo-fonte">
    {t.source}: <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo.com</a>{' '}
    (<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>)
  </p>
</section>

<style>
  .meteo {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(43, 43, 38, 0.06);
  }
  .meteo[hidden] {
    display: none;
  }
  .meteo h2 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
  }
  .meteo-nota {
    margin: -0.6rem 0 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .meteo-stato {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .meteo-giorni {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 0.6rem;
  }
  .meteo-giorni[hidden] {
    display: none;
  }
  .meteo-giorni :global(li) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.6rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-align: center;
  }
  .meteo-giorni :global(li.weekend) {
    border-color: var(--color-accent);
    background: #f3f5ea;
  }
  .meteo-giorni :global(.giorno) {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .meteo-giorni :global(.icona) {
    font-size: 1.8rem;
    line-height: 1.2;
  }
  .meteo-giorni :global(.descrizione) {
    font-size: 0.75rem;
    color: var(--color-muted);
    min-height: 2em;
  }
  .meteo-giorni :global(.temperature) {
    font-size: 0.9rem;
  }
  .meteo-giorni :global(.temperature .min) {
    color: var(--color-muted);
  }
  .meteo-giorni :global(.pioggia) {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .meteo-fonte {
    margin: 1rem 0 0;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
</style>

<script>
  // Coordinate del centro di San Vito Romano (Piazza Augusto Baccelli)
  const LAT = 41.8826;
  const LNG = 12.9829;

  // Codici meteo WMO usati da Open-Meteo → icona e descrizione
  const CODICI: Record<number, [string, string, string]> = {
    0: ['☀️', 'Sereno', 'Clear sky'],
    1: ['🌤️', 'Poco nuvoloso', 'Mainly clear'],
    2: ['⛅', 'Parz. nuvoloso', 'Partly cloudy'],
    3: ['☁️', 'Coperto', 'Overcast'],
    45: ['🌫️', 'Nebbia', 'Fog'],
    48: ['🌫️', 'Nebbia', 'Fog'],
    51: ['🌦️', 'Pioviggine', 'Light drizzle'],
    53: ['🌦️', 'Pioviggine', 'Drizzle'],
    55: ['🌧️', 'Pioviggine', 'Heavy drizzle'],
    56: ['🌧️', 'Pioviggine gelata', 'Freezing drizzle'],
    57: ['🌧️', 'Pioviggine gelata', 'Freezing drizzle'],
    61: ['🌦️', 'Pioggia debole', 'Light rain'],
    63: ['🌧️', 'Pioggia', 'Rain'],
    65: ['🌧️', 'Pioggia forte', 'Heavy rain'],
    66: ['🌧️', 'Pioggia gelata', 'Freezing rain'],
    67: ['🌧️', 'Pioggia gelata', 'Freezing rain'],
    71: ['🌨️', 'Neve debole', 'Light snow'],
    73: ['🌨️', 'Neve', 'Snow'],
    75: ['❄️', 'Neve forte', 'Heavy snow'],
    77: ['🌨️', 'Nevischio', 'Snow grains'],
    80: ['🌦️', 'Rovesci deboli', 'Light showers'],
    81: ['🌧️', 'Rovesci', 'Showers'],
    82: ['⛈️', 'Rovesci forti', 'Heavy showers'],
    85: ['🌨️', 'Rovesci di neve', 'Snow showers'],
    86: ['❄️', 'Rovesci di neve', 'Snow showers'],
    95: ['⛈️', 'Temporale', 'Thunderstorm'],
    96: ['⛈️', 'Temporale con grandine', 'Thunderstorm with hail'],
    99: ['⛈️', 'Temporale con grandine', 'Thunderstorm with hail'],
  };

  const oggiRoma = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Rome' }).format(new Date());
  const giorniTra = (da: string, a: string) => Math.round((Date.parse(a) - Date.parse(da)) / 86400000);

  document.querySelectorAll<HTMLElement>('.meteo').forEach(async (box) => {
    const en = box.dataset.lang === 'en';
    const inizio = box.dataset.weekendInizio;
    const fine = box.dataset.weekendFine;
    const stato = box.querySelector('.meteo-stato') as HTMLElement;
    const lista = box.querySelector('.meteo-giorni') as HTMLOListElement;
    const oggi = oggiRoma();

    // Negli articoli di un weekend già passato le previsioni non servono più
    if (fine && fine < oggi) {
      box.hidden = true;
      return;
    }
    // Di norma 7 giorni; se il weekend è più avanti si allunga fino a includerlo (Open-Meteo arriva a 16)
    const giorni = fine ? Math.min(16, Math.max(7, giorniTra(oggi, fine) + 1)) : 7;

    const url =
      `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LNG}` +
      '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max' +
      `&timezone=Europe%2FRome&forecast_days=${giorni}`;

    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(String(res.status));
      const { daily } = await res.json();
      const locale = en ? 'en-GB' : 'it-IT';

      lista.innerHTML = '';
      daily.time.forEach((data: string, i: number) => {
        const [icona, descIt, descEn] = CODICI[daily.weather_code[i]] ?? ['🌡️', '', ''];
        const giornoSett = new Intl.DateTimeFormat(locale, { weekday: 'short', day: 'numeric', timeZone: 'UTC' }).format(
          new Date(`${data}T12:00:00Z`),
        );
        const nome = i === 0 ? (en ? 'Today' : 'Oggi') : i === 1 ? (en ? 'Tomorrow' : 'Domani') : giornoSett;
        const pioggia = daily.precipitation_probability_max[i];

        const li = document.createElement('li');
        if (inizio && fine && data >= inizio && data <= fine) li.classList.add('weekend');
        li.innerHTML = `
          <span class="giorno"></span>
          <span class="icona" aria-hidden="true">${icona}</span>
          <span class="descrizione"></span>
          <span class="temperature">${Math.round(daily.temperature_2m_max[i])}° <span class="min">/ ${Math.round(daily.temperature_2m_min[i])}°</span></span>
          ${pioggia == null ? '' : `<span class="pioggia" title="${en ? 'Chance of rain' : 'Probabilità di pioggia'}">💧 ${pioggia}%</span>`}
        `;
        (li.querySelector('.giorno') as HTMLElement).textContent = nome.charAt(0).toUpperCase() + nome.slice(1);
        (li.querySelector('.descrizione') as HTMLElement).textContent = en ? descEn : descIt;
        lista.appendChild(li);
      });

      stato.hidden = true;
      lista.hidden = false;
    } catch {
      stato.textContent = en ? 'The forecast is not available at the moment.' : 'Le previsioni non sono disponibili al momento.';
    }
  });
</script>
