---
import { withBase } from '../lib/url';

interface Props {
  gpx?: string;
  partenza?: { lat: number; lng: number };
}

const { gpx, partenza } = Astro.props;
const gpxUrl = gpx ? withBase(gpx) : '';
---

<div
  class="trail-map"
  data-gpx={gpxUrl}
  data-lat={partenza?.lat ?? ''}
  data-lng={partenza?.lng ?? ''}
>
</div>

<style>
  .trail-map {
    width: 100%;
    height: 400px;
    border-radius: 10px;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    background: #eee;
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  async function initMap(el: HTMLElement) {
    const gpxPath = el.dataset.gpx;
    const lat = parseFloat(el.dataset.lat || '');
    const lng = parseFloat(el.dataset.lng || '');

    const map = L.map(el);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
    }).addTo(map);

    let hasView = false;

    if (gpxPath) {
      try {
        const res = await fetch(gpxPath);
        const text = await res.text();
        const xml = new DOMParser().parseFromString(text, 'application/xml');
        const points = Array.from(xml.querySelectorAll('trkpt')).map(
          (pt) =>
            [
              parseFloat(pt.getAttribute('lat') ?? '0'),
              parseFloat(pt.getAttribute('lon') ?? '0'),
            ] as [number, number]
        );

        if (points.length > 0) {
          const line = L.polyline(points, { color: '#6b7f3a', weight: 4 }).addTo(map);
          map.fitBounds(line.getBounds(), { padding: [20, 20] });
          L.marker(points[0]).addTo(map).bindPopup('Partenza');
          L.marker(points[points.length - 1]).addTo(map).bindPopup('Arrivo');
          hasView = true;
        }
      } catch (err) {
        console.error('Impossibile caricare il tracciato GPX:', err);
      }
    }

    if (!hasView && !Number.isNaN(lat) && !Number.isNaN(lng)) {
      map.setView([lat, lng], 14);
      L.marker([lat, lng]).addTo(map).bindPopup('Partenza');
      hasView = true;
    }

    if (!hasView) {
      map.setView([41.9, 12.5], 6);
    }
  }

  document.querySelectorAll<HTMLElement>('.trail-map').forEach((el) => {
    initMap(el);
  });
</script>
