---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  tag?: string;
  luogo?: string;
  image?: ImageMetadata;
}

const { href, title, description, tag, luogo, image } = Astro.props;
---

<a class="card" href={href}>
  {image && <Image src={image} alt={title} width={480} height={360} />}
  <div class="card-body">
    {tag && <span class="tag">{tag}</span>}
    <h3>{title}</h3>
    <p>{description}</p>
    {luogo && <p class="luogo">📍 {luogo}</p>}
  </div>
</a>

<style>
  .luogo {
    font-weight: 600;
    margin-top: 0.3rem;
  }
</style>
