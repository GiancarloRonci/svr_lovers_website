---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  tag?: string;
  tagClass?: string;
  meta?: string;
  luogo?: string;
  distanza?: string;
  nota?: string;
  image?: ImageMetadata;
  // Parte dell'immagine da tenere nel ritaglio 4:3 (es. "left bottom"); senza, il centro
  imagePosition?: string;
  dataInizio?: Date;
  dataFine?: Date;
}

const { href, title, description, tag, tagClass = 'tag', meta, luogo, distanza, nota, image, imagePosition, dataInizio, dataFine } = Astro.props;
// Event cards expose their dates and type to the filters on the events page.
const eventAttrs = dataInizio
  ? {
      'data-inizio': dataInizio.toISOString().slice(0, 10),
      'data-fine': (dataFine ?? dataInizio).toISOString().slice(0, 10),
      'data-tipo': tag ?? '',
    }
  : {};
---

<a class="card" href={href} {...eventAttrs}>
  <slot />
  {
    image && (
      <Image
        src={image}
        alt={title}
        width={480}
        height={360}
        position={imagePosition}
        style={imagePosition ? `object-position: ${imagePosition}` : undefined}
      />
    )
  }
  <div class="card-body">
    {tag && <span class={tagClass}>{tag}</span>}
    <h3>{title}</h3>
    {meta && <p class="card-meta">📅 {meta}</p>}
    <p>{description}</p>
    {luogo && <p class="luogo">📍 {luogo}</p>}
    {distanza && <p class="distanza">🚗 {distanza}</p>}
    {nota && <p class="nota">⏳ {nota}</p>}
  </div>
</a>

<style>
  /* Riferimento per le etichette passate nello slot, posizionate sopra la copertina */
  .card {
    position: relative;
  }
  .card-meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0.1rem 0 0.4rem;
  }
  .luogo {
    font-weight: 600;
    margin-top: 0.3rem;
  }
  .distanza {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-top: 0.2rem;
  }
  .nota {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-style: italic;
    margin-top: 0.4rem;
  }
</style>
