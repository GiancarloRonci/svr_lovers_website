---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  tag?: string;
  image?: ImageMetadata;
}

const { href, title, description, tag, image } = Astro.props;
---

<a class="card" href={href}>
  {image && <Image src={image} alt={title} width={480} height={360} />}
  <div class="card-body">
    {tag && <span class="tag">{tag}</span>}
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>
