---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  tag?: string;
  meta?: string;
  luogo?: string;
  image?: ImageMetadata;
}

const { href, title, description, tag, meta, luogo, image } = Astro.props;
---

<a class="card" href={href}>
  {image && <Image src={image} alt={title} width={480} height={360} />}
  <div class="card-body">
    {tag && <span class="tag">{tag}</span>}
    <h3>{title}</h3>
    {meta && <p class="card-meta">📅 {meta}</p>}
    <p>{description}</p>
    {luogo && <p class="luogo">📍 {luogo}</p>}
  </div>
</a>

<style>
  .card-meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0.1rem 0 0.4rem;
  }
  .luogo {
    font-weight: 600;
    margin-top: 0.3rem;
  }
</style>
