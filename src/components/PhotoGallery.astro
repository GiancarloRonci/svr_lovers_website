---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  immagine: ImageMetadata;
  full: string;
  alt: string;
  caption: string;
  // Autore della foto, già formattato (es. "📷 Redazione SVR Lovers")
  credit?: string;
  name: string;
}

interface Props {
  items: GalleryItem[];
  lang?: 'it' | 'en';
}

const { items, lang = 'it' } = Astro.props;
const labels =
  lang === 'en'
    ? { close: 'Close', prev: 'Previous photo', next: 'Next photo', photos: 'The photos' }
    : { close: 'Chiudi', prev: 'Foto precedente', next: 'Foto successiva', photos: 'Le foto' };
---

{
  items.some((item) => item.caption) && (
    <section class="foto-elenco">
      <h2>{labels.photos}</h2>
      <ul>
        {items.map((item) => (
          <li>
            <strong>{item.name}</strong>
            {item.caption && `: ${item.caption}`}
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  items.length > 0 && (
    <div class="photo-gallery">
      <section class="gallery">
        {items.map((item) => (
          <button type="button" class="gallery-item" data-full={item.full} data-caption={item.caption} data-name={item.name} data-credit={item.credit}>
            <Image src={item.immagine} alt={item.alt} width={400} height={300} />
          </button>
        ))}
      </section>

      <div class="lightbox" hidden>
        <button type="button" class="lightbox-close" aria-label={labels.close}>&times;</button>
        <button type="button" class="lightbox-prev" aria-label={labels.prev}>&larr;</button>
        <figure class="lightbox-figure">
          <img class="lightbox-img" alt="" />
          <figcaption class="lightbox-caption">
          <span class="lightbox-text"></span>
          <span class="lightbox-credit"></span>
        </figcaption>
        </figure>
        <button type="button" class="lightbox-next" aria-label={labels.next}>&rarr;</button>
      </div>
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .gallery-item {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox-figure {
    margin: 0;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .lightbox-img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 4px;
  }
  .lightbox-caption {
    color: #fff;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }
  .lightbox-text,
  .lightbox-credit {
    display: block;
  }
  .lightbox-credit {
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: #bbb;
  }
  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.photo-gallery').forEach((container) => {
    const lightbox = container.querySelector<HTMLElement>('.lightbox');
    if (!lightbox) return;

    const items = Array.from(container.querySelectorAll<HTMLButtonElement>('.gallery-item'));
    const img = lightbox.querySelector('.lightbox-img') as HTMLImageElement;
    const caption = lightbox.querySelector('.lightbox-text') as HTMLElement;
    const credit = lightbox.querySelector('.lightbox-credit') as HTMLElement;
    let current = 0;

    const render = () => {
      img.src = items[current].dataset.full ?? '';
      const name = items[current].dataset.name ?? '';
      const desc = items[current].dataset.caption ?? '';
      caption.textContent = desc ? `${name}: ${desc}` : name;
      credit.textContent = items[current].dataset.credit ?? '';
    };
    const open = (i: number) => {
      current = i;
      render();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    };
    const move = (delta: number) => {
      current = (current + delta + items.length) % items.length;
      render();
    };

    items.forEach((item, i) => item.addEventListener('click', () => open(i)));
    lightbox.querySelector('.lightbox-close')?.addEventListener('click', close);
    lightbox.querySelector('.lightbox-prev')?.addEventListener('click', () => move(-1));
    lightbox.querySelector('.lightbox-next')?.addEventListener('click', () => move(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') move(-1);
      if (e.key === 'ArrowRight') move(1);
    });
  });
</script>
