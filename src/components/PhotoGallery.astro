---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  immagine: ImageMetadata;
  full: string;
  alt: string;
  caption: string;
  // Autore della foto, già formattato (es. "📷 Redazione SVR Lovers")
  credit?: string;
  name: string;
}

interface Props {
  items: GalleryItem[];
  lang?: 'it' | 'en';
  // Mostra il numero d'ordine di ogni foto in un cerchietto (miniatura, elenco e ingrandimento), come sulla mappa
  numerata?: boolean;
  // Titolo dell'elenco delle didascalie, se diverso da "Le foto" (es. "Foto lungo il percorso")
  titolo?: string;
}

const { items, lang = 'it', numerata = false, titolo } = Astro.props;
const labels =
  lang === 'en'
    ? { close: 'Close', prev: 'Previous photo', next: 'Next photo', photos: 'The photos', open: 'Open the photo' }
    : { close: 'Chiudi', prev: 'Foto precedente', next: 'Foto successiva', photos: 'Le foto', open: 'Apri la foto' };
---

{
  items.length > 0 && (
    <div class="photo-gallery">
      {items.some((item) => item.caption) && (
        <section class="foto-elenco">
          <h2>{titolo ?? labels.photos}</h2>
          <ul class:list={{ numerata }}>
            {items.map((item, i) => (
              <li>
                {numerata && <span class="foto-num">{i + 1}</span>}
                <button type="button" class="foto-apri" data-index={i} title={labels.open}>{item.name}</button>
                {item.caption && `: ${item.caption}`}
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="gallery">
        {items.map((item, i) => (
          <button type="button" class="gallery-item" data-full={item.full} data-caption={item.caption} data-name={item.name} data-credit={item.credit} data-num={numerata ? i + 1 : undefined}>
            <Image src={item.immagine} alt={item.alt} width={400} height={300} />
            {numerata && <span class="foto-num" aria-hidden="true">{i + 1}</span>}
          </button>
        ))}
      </section>

      <div class="lightbox" hidden>
        <button type="button" class="lightbox-close" aria-label={labels.close}>&times;</button>
        <button type="button" class="lightbox-prev" aria-label={labels.prev}>‹</button>
        <figure class="lightbox-figure">
          <img class="lightbox-img" alt="" />
          <figcaption class="lightbox-caption">
          <span class="lightbox-text"><span class="foto-num lightbox-num" hidden></span><span class="lightbox-desc"></span></span>
          <span class="lightbox-credit"></span>
        </figcaption>
        </figure>
        <button type="button" class="lightbox-next" aria-label={labels.next}>›</button>
      </div>
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .gallery-item {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  /* Numero d'ordine della foto, uguale a quello sulla mappa */
  .foto-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
  }
  .gallery-item .foto-num {
    position: absolute;
    top: 0.4rem;
    left: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
  }
  .foto-elenco .foto-num {
    margin-right: 0.4rem;
  }
  /* Il nome della foto nell'elenco è un link che apre l'ingrandimento */
  .foto-apri {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: zoom-in;
  }
  .foto-apri:hover {
    text-decoration-thickness: 2px;
  }

  /* Con i numeri d'ordine il punto dell'elenco non serve */
  .foto-elenco ul.numerata {
    list-style: none;
    padding-left: 0;
  }
  /* Il testo che va a capo resta allineato a destra del numero */
  .foto-elenco ul.numerata li {
    position: relative;
    padding-left: 2.1rem;
    margin-bottom: 0.3rem;
  }
  .foto-elenco ul.numerata .foto-num {
    position: absolute;
    left: 0;
    top: 0.05rem;
    margin-right: 0;
  }
  .lightbox-num {
    margin-right: 0.4rem;
    border: 1px solid #fff;
  }
  .lightbox-num[hidden] {
    display: none;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox-figure {
    margin: 0;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .lightbox-img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 4px;
  }
  .lightbox-caption {
    color: #fff;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }
  .lightbox-text,
  .lightbox-credit {
    display: block;
  }
  .lightbox-credit {
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: #bbb;
  }
  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }
  /* Frecce grandi senza cerchio, come nel visore della selezione del contest */
  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    width: auto;
    height: auto;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    background: none;
    font-size: 3.5rem;
  }
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .lightbox-prev {
    left: 0.5rem;
  }
  .lightbox-next {
    right: 0.5rem;
  }
  @media (max-width: 600px) {
    .lightbox-prev,
    .lightbox-next {
      font-size: 2.5rem;
      background: rgba(0, 0, 0, 0.35);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.photo-gallery').forEach((container) => {
    const lightbox = container.querySelector<HTMLElement>('.lightbox');
    if (!lightbox) return;

    const items = Array.from(container.querySelectorAll<HTMLButtonElement>('.gallery-item'));
    const img = lightbox.querySelector('.lightbox-img') as HTMLImageElement;
    const num = lightbox.querySelector('.lightbox-num') as HTMLElement;
    const caption = lightbox.querySelector('.lightbox-desc') as HTMLElement;
    const credit = lightbox.querySelector('.lightbox-credit') as HTMLElement;
    let current = 0;

    const render = () => {
      img.src = items[current].dataset.full ?? '';
      const name = items[current].dataset.name ?? '';
      const desc = items[current].dataset.caption ?? '';
      num.textContent = items[current].dataset.num ?? '';
      num.hidden = !items[current].dataset.num;
      caption.textContent = desc ? `${name}: ${desc}` : name;
      credit.textContent = items[current].dataset.credit ?? '';
    };
    const open = (i: number) => {
      current = i;
      render();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    };
    const move = (delta: number) => {
      current = (current + delta + items.length) % items.length;
      render();
    };

    items.forEach((item, i) => item.addEventListener('click', () => open(i)));
    container.querySelectorAll<HTMLButtonElement>('.foto-apri').forEach((link) =>
      link.addEventListener('click', () => open(Number(link.dataset.index)))
    );
    lightbox.querySelector('.lightbox-close')?.addEventListener('click', close);
    lightbox.querySelector('.lightbox-prev')?.addEventListener('click', () => move(-1));
    lightbox.querySelector('.lightbox-next')?.addEventListener('click', () => move(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') move(-1);
      if (e.key === 'ArrowRight') move(1);
    });
  });
</script>
