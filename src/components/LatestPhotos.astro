---
import { Image } from 'astro:assets';
import { getLatestPhotos } from '../lib/siteUpdates';
import { withBase } from '../lib/url';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const photos = await getLatestPhotos(lang, 8);
const heading = lang === 'en' ? 'Latest photos' : 'Ultime foto';
const allLabel = lang === 'en' ? 'See all photos' : 'Vedi tutte le foto';
const allHref = withBase(`${lang === 'en' ? 'en/' : ''}ultime-foto/`);
---

{
  photos.length > 0 && (
    <section class="latest-photos">
      <h2>{heading}</h2>
      <ul class="photo-grid">
        {photos.map((p) => (
          <li>
            <a href={withBase(p.href)} title={p.title}>
              <Image src={p.image} alt={p.title} width={240} height={240} loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
      <p class="all-photos">
        <a href={allHref}>{allLabel} &rarr;</a>
      </p>
    </section>
  )
}

<style>
  .latest-photos {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(43, 43, 38, 0.06);
  }
  .latest-photos h2 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
  }
  .photo-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 0.6rem;
  }
  .photo-grid a {
    display: block;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
  }
  .photo-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s;
  }
  .all-photos {
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }
  .photo-grid a:hover img {
    transform: scale(1.05);
  }
</style>
