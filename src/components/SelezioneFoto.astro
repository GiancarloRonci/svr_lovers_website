---
// Area riservata ai selezionatori: accesso con email e password personali, galleria anonima delle
// foto in concorso con like da mettere e togliere, classifica parziale in fondo alla pagina.
// Tutti i dati passano dalla web app dello script Google configurata in `src/lib/selezione.ts`.
import type { Selezione } from '../lib/selezione';

interface Props {
  lang: 'it' | 'en';
  slug: string;
  selezione: Selezione;
}

const { lang, slug, selezione } = Astro.props;

const strings = {
  it: {
    intro:
      'Questa pagina è riservata ai selezionatori del contest. Metti il like alle foto che vorresti vedere tra le 20 finaliste: puoi metterlo a quante foto vuoi e toglierlo quando vuoi, fino alla chiusura delle votazioni.',
    chiusura: 'Le votazioni si chiudono il',
    nonAttiva: 'La votazione non è ancora attiva. Riprova più tardi.',
    email: 'Email',
    password: 'Password',
    entra: 'Entra',
    esci: 'Esci',
    accessoCome: 'Accesso come',
    caricamento: 'Caricamento…',
    erroreCredenziali: 'Email o password non corrette.',
    erroreRete: 'Impossibile contattare il server. Controlla la connessione e riprova.',
    erroreChiuso: 'Le votazioni sono chiuse: i like non si possono più cambiare.',
    errorePropria: 'Non puoi mettere il like alle tue foto.',
    tuaFoto: 'La tua foto',
    elimina: 'Elimina',
    eliminaFoto: 'Elimina la tua foto',
    confermaTitolo: 'Eliminare la foto?',
    confermaTesto: (c: string) =>
      `La foto ${c} verrà tolta dal contest: non sarà più visibile ai selezionatori e i like ricevuti non verranno più contati.`,
    confermaSi: 'Sì, elimina',
    annulla: 'Annulla',
    erroreElimina: 'Non è stato possibile eliminare la foto. Riprova.',
    chiuso: 'Le votazioni sono chiuse. Qui sotto trovi la classifica finale.',
    galleria: 'Le foto in concorso',
    nessunaFoto: 'Non ci sono ancora foto da votare.',
    tuoiLike: (n: string, tot: string) => `Hai messo il like a ${n} foto su ${tot}.`,
    like: 'Mi piace',
    togliLike: 'Togli il like',
    ingrandisci: 'Apri la foto ingrandita',
    precedente: 'Foto precedente',
    successiva: 'Foto successiva',
    chiudi: 'Chiudi',
    posizione: (i: string, n: string) => `${i} di ${n}`,
    foto: 'Foto',
    classifica: 'Classifica parziale',
    classificaNota:
      'Il conteggio si aggiorna a ogni like. Le prime 20 foto (evidenziate) sono quelle che oggi andrebbero in finale.',
    likeCount: (n: number) => (n === 1 ? '1 like' : `${n} like`),
  },
  en: {
    intro:
      'This page is reserved for the contest selectors. Like the photos you would like to see among the 20 finalists: you can like as many photos as you want and remove a like at any time, until voting closes.',
    chiusura: 'Voting closes on',
    nonAttiva: 'Voting is not open yet. Please try again later.',
    email: 'Email',
    password: 'Password',
    entra: 'Enter',
    esci: 'Log out',
    accessoCome: 'Logged in as',
    caricamento: 'Loading…',
    erroreCredenziali: 'Incorrect email or password.',
    erroreRete: 'Unable to reach the server. Check your connection and try again.',
    erroreChiuso: 'Voting is closed: likes can no longer be changed.',
    errorePropria: 'You cannot like your own photos.',
    tuaFoto: 'Your photo',
    elimina: 'Delete',
    eliminaFoto: 'Delete your photo',
    confermaTitolo: 'Delete the photo?',
    confermaTesto: (c: string) =>
      `Photo ${c} will be removed from the contest: selectors will no longer see it and its likes will no longer be counted.`,
    confermaSi: 'Yes, delete',
    annulla: 'Cancel',
    erroreElimina: 'The photo could not be deleted. Please try again.',
    chiuso: 'Voting is closed. The final ranking is below.',
    galleria: 'The photos in the contest',
    nessunaFoto: 'There are no photos to vote on yet.',
    tuoiLike: (n: string, tot: string) => `You have liked ${n} of ${tot} photos.`,
    like: 'Like',
    togliLike: 'Remove like',
    ingrandisci: 'Open the enlarged photo',
    precedente: 'Previous photo',
    successiva: 'Next photo',
    chiudi: 'Close',
    posizione: (i: string, n: string) => `${i} of ${n}`,
    foto: 'Photo',
    classifica: 'Current ranking',
    classificaNota:
      'The count updates with every like. The top 20 photos (highlighted) are the ones that would currently reach the final.',
    likeCount: (n: number) => (n === 1 ? '1 like' : `${n} likes`),
  },
} as const;

const t = strings[lang];
const locale = lang === 'en' ? 'en-GB' : 'it-IT';
const chiusuraTesto = new Date(selezione.chiusura).toLocaleString(locale, {
  timeZone: 'Europe/Rome',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

// Testi passati allo script del browser (le funzioni non si possono serializzare)
const testi = {
  caricamento: t.caricamento,
  erroreCredenziali: t.erroreCredenziali,
  erroreRete: t.erroreRete,
  erroreChiuso: t.erroreChiuso,
  errorePropria: t.errorePropria,
  tuaFoto: t.tuaFoto,
  elimina: t.elimina,
  eliminaFoto: t.eliminaFoto,
  confermaTesto: t.confermaTesto('{codice}'),
  erroreElimina: t.erroreElimina,
  nessunaFoto: t.nessunaFoto,
  tuoiLike: t.tuoiLike('{n}', '{tot}'),
  like: t.like,
  togliLike: t.togliLike,
  ingrandisci: t.ingrandisci,
  posizione: t.posizione('{i}', '{n}'),
  foto: t.foto,
  likeUno: t.likeCount(1),
  likeMolti: t.likeCount(2).replace('2', '{n}'),
};
const scriptUrl = selezione.scriptUrl;
const chiaveMemoria = `svr-selezione-${slug}`;
---

<div class="selezione">
  <p>{t.intro}</p>
  <p class="meta">{t.chiusura} {chiusuraTesto}.</p>

  {
    !scriptUrl ? (
      <p class="avviso">{t.nonAttiva}</p>
    ) : (
      <>
        <form id="sel-accesso" class="sel-accesso" hidden>
          <label>
            {t.email}
            <input type="email" name="email" autocomplete="username" required />
          </label>
          <label>
            {t.password}
            <input type="password" name="password" autocomplete="current-password" required />
          </label>
          <button type="submit">{t.entra}</button>
        </form>

        <p id="sel-stato" class="meta" role="status" aria-live="polite" />
        <p id="sel-errore" class="avviso" role="alert" hidden />

        <div id="sel-area" hidden>
          <p class="sel-utente">
            {t.accessoCome} <strong id="sel-email" /> · <button type="button" id="sel-esci" class="link">{t.esci}</button>
          </p>
          <p id="sel-chiuso" class="avviso" hidden>{t.chiuso}</p>

          <h2>{t.galleria}</h2>
          <p id="sel-conteggio" class="meta" />
          <ul id="sel-galleria" class="sel-galleria" />

          <h2>{t.classifica}</h2>
          <p class="meta">{t.classificaNota}</p>
          <ol id="sel-classifica" class="sel-classifica" />
        </div>

        <dialog id="sel-visore" class="sel-visore" aria-label={t.ingrandisci}>
          <button type="button" class="sel-chiudi" id="sel-visore-chiudi" aria-label={t.chiudi}>✕</button>
          <button type="button" class="sel-freccia sel-prec" id="sel-visore-prec" aria-label={t.precedente}>‹</button>
          <img id="sel-visore-img" alt="" />
          <button type="button" class="sel-freccia sel-succ" id="sel-visore-succ" aria-label={t.successiva}>›</button>
          <div class="sel-visore-barra">
            <span id="sel-visore-codice" class="sel-visore-codice" />
            <span id="sel-visore-posizione" class="sel-visore-posizione" />
            <button type="button" class="sel-like" id="sel-visore-like" />
            <button type="button" class="sel-elimina" id="sel-visore-elimina" hidden>{t.elimina}</button>
          </div>
          <p id="sel-visore-errore" class="sel-visore-errore" role="alert" hidden />

        </dialog>

        <dialog id="sel-conferma" class="sel-conferma" aria-labelledby="sel-conferma-titolo">
          <h2 id="sel-conferma-titolo">{t.confermaTitolo}</h2>
          <p id="sel-conferma-testo" />
          <div class="sel-conferma-bottoni">
            <button type="button" id="sel-conferma-no" class="secondario">{t.annulla}</button>
            <button type="button" id="sel-conferma-si" class="pericolo">{t.confermaSi}</button>
          </div>
        </dialog>
      </>
    )
  }
</div>

{
  scriptUrl && (
    <script is:inline define:vars={{ scriptUrl, chiaveMemoria, testi }}>
      (function () {
        var form = document.getElementById('sel-accesso');
        var stato = document.getElementById('sel-stato');
        var errore = document.getElementById('sel-errore');
        var area = document.getElementById('sel-area');
        var galleria = document.getElementById('sel-galleria');
        var classifica = document.getElementById('sel-classifica');
        var conteggio = document.getElementById('sel-conteggio');
        var credenziali = null;
        var dati = null;

        function leggiMemoria() {
          try {
            var v = JSON.parse(localStorage.getItem(chiaveMemoria) || 'null');
            return v && v.email && v.password ? v : null;
          } catch (e) {
            return null;
          }
        }
        function scriviMemoria(v) {
          try {
            if (v) localStorage.setItem(chiaveMemoria, JSON.stringify(v));
            else localStorage.removeItem(chiaveMemoria);
          } catch (e) {}
        }
        // Richiesta "semplice" (testo, niente intestazioni) per evitare il controllo CORS preliminare
        function chiama(corpo) {
          return fetch(scriptUrl, { method: 'POST', body: JSON.stringify(corpo) }).then(function (r) {
            if (!r.ok) throw new Error('http');
            return r.json();
          });
        }

        function testoLike(n) {
          return n === 1 ? testi.likeUno : testi.likeMolti.replace('{n}', n);
        }

        function haLike(codice) {
          return dati.miei.indexOf(codice) >= 0;
        }

        // Stato del cuore (pieno/vuoto) per un bottone della galleria o del visore
        function eMia(codice) {
          return dati.foto.some(function (f) {
            return f.codice === codice && f.propria;
          });
        }

        function preparaLike(bottone, codice) {
          // Le proprie foto non si possono votare: al posto del cuore compare "La tua foto"
          if (eMia(codice)) {
            bottone.classList.add('propria');
            bottone.removeAttribute('aria-pressed');
            bottone.removeAttribute('aria-label');
            bottone.textContent = testi.tuaFoto;
            bottone.disabled = true;
            return;
          }
          var attivo = haLike(codice);
          bottone.classList.remove('propria');
          bottone.setAttribute('aria-pressed', attivo ? 'true' : 'false');
          bottone.setAttribute('aria-label', (attivo ? testi.togliLike : testi.like) + ' – ' + codice);
          bottone.textContent = attivo ? '♥' : '♡';
          bottone.disabled = dati.chiuso;
        }

        // Visore a schermo intero: frecce, tasti ← → , swipe e like
        var visore = document.getElementById('sel-visore');
        var visoreImg = document.getElementById('sel-visore-img');
        var visoreLike = document.getElementById('sel-visore-like');
        var visoreErrore = document.getElementById('sel-visore-errore');
        var aperta = -1;

        function mostraFoto(i) {
          var n = dati.foto.length;
          if (!n) return;
          aperta = (i + n) % n;
          var f = dati.foto[aperta];
          visoreImg.src = f.grande;
          visoreImg.alt = testi.foto + ' ' + f.codice;
          document.getElementById('sel-visore-codice').textContent = f.codice;
          document.getElementById('sel-visore-posizione').textContent = testi.posizione
            .replace('{i}', aperta + 1)
            .replace('{n}', n);
          preparaLike(visoreLike, f.codice);
          preparaEliminaVisore();
          visoreErrore.hidden = true;
          // Precarica le foto vicine, così lo scorrimento è immediato
          [aperta + 1, aperta - 1].forEach(function (j) {
            new Image().src = dati.foto[(j + n) % n].grande;
          });
        }

        function apriFoto(i) {
          mostraFoto(i);
          if (!visore.open) visore.showModal();
        }

        document.getElementById('sel-visore-prec').addEventListener('click', function () {
          mostraFoto(aperta - 1);
        });
        document.getElementById('sel-visore-succ').addEventListener('click', function () {
          mostraFoto(aperta + 1);
        });
        document.getElementById('sel-visore-chiudi').addEventListener('click', function () {
          visore.close();
        });
        visoreLike.addEventListener('click', function () {
          var codice = dati.foto[aperta].codice;
          cambiaLike(codice, !haLike(codice), visoreLike);
        });

        // Eliminazione delle proprie foto, dopo la conferma in una finestra della pagina
        var visoreElimina = document.getElementById('sel-visore-elimina');
        var conferma = document.getElementById('sel-conferma');
        var confermaSi = document.getElementById('sel-conferma-si');
        var daEliminare = null;

        function preparaEliminaVisore() {
          visoreElimina.hidden = dati.chiuso || !eMia(dati.foto[aperta].codice);
          visoreElimina.setAttribute('aria-label', testi.eliminaFoto + ' – ' + dati.foto[aperta].codice);
        }

        function chiediElimina(codice) {
          daEliminare = codice;
          document.getElementById('sel-conferma-testo').textContent = testi.confermaTesto.replace('{codice}', codice);
          confermaSi.disabled = false;
          conferma.showModal();
        }

        visoreElimina.addEventListener('click', function () {
          chiediElimina(dati.foto[aperta].codice);
        });
        document.getElementById('sel-conferma-no').addEventListener('click', function () {
          conferma.close();
        });
        confermaSi.addEventListener('click', function () {
          confermaSi.disabled = true;
          eliminaFoto(daEliminare);
        });

        function eliminaFoto(codice) {
          mostraErrore('');
          chiama({
            azione: 'elimina',
            email: credenziali.email,
            password: credenziali.password,
            codice: codice,
          })
            .then(function (r) {
              conferma.close();
              if (r.ok) {
                dati.foto = r.foto;
                // Nel visore resta aperta la foto successiva, o si chiude se non ce ne sono più
                if (visore.open) {
                  if (dati.foto.length) mostraFoto(aperta);
                  else visore.close();
                }
                return aggiorna(r);
              }
              if (r.errore === 'chiuso') {
                mostraErrore(testi.erroreChiuso);
                dati.chiuso = true;
                return disegna();
              }
              if (r.errore === 'credenziali') return esci(testi.erroreCredenziali);
              mostraErrore(testi.erroreElimina);
            })
            .catch(function () {
              conferma.close();
              mostraErrore(testi.erroreRete);
            });
        }
        visore.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft') mostraFoto(aperta - 1);
          else if (e.key === 'ArrowRight') mostraFoto(aperta + 1);
          else return;
          e.preventDefault();
        });
        // Clic sullo sfondo scuro (fuori dalla foto e dai comandi) chiude il visore
        visore.addEventListener('click', function (e) {
          if (e.target === visore) visore.close();
        });
        var inizioX = null;
        visore.addEventListener('touchstart', function (e) {
          inizioX = e.touches.length === 1 ? e.touches[0].clientX : null;
        });
        visore.addEventListener('touchend', function (e) {
          if (inizioX === null) return;
          var dx = e.changedTouches[0].clientX - inizioX;
          inizioX = null;
          if (Math.abs(dx) > 50) mostraFoto(aperta + (dx < 0 ? 1 : -1));
        });

        function disegna() {
          var immagini = {};
          dati.foto.forEach(function (f) {
            immagini[f.codice] = f;
          });

          document.getElementById('sel-chiuso').hidden = !dati.chiuso;
          conteggio.textContent = testi.tuoiLike
            .replace('{n}', dati.miei.length)
            .replace('{tot}', dati.foto.length);

          galleria.textContent = '';
          if (!dati.foto.length) {
            var vuoto = document.createElement('li');
            vuoto.className = 'meta';
            vuoto.textContent = testi.nessunaFoto;
            galleria.appendChild(vuoto);
          }
          dati.foto.forEach(function (f, i) {
            var li = document.createElement('li');
            li.className = 'sel-foto';

            var link = document.createElement('a');
            link.href = f.grande;
            link.title = testi.ingrandisci;
            link.addEventListener('click', function (e) {
              e.preventDefault();
              apriFoto(i);
            });
            var img = document.createElement('img');
            img.src = f.img;
            img.alt = testi.foto + ' ' + f.codice;
            img.loading = 'lazy';
            link.appendChild(img);

            var riga = document.createElement('div');
            riga.className = 'sel-riga';
            var codice = document.createElement('span');
            codice.textContent = f.codice;
            var bottone = document.createElement('button');
            bottone.type = 'button';
            bottone.className = 'sel-like';
            preparaLike(bottone, f.codice);
            bottone.addEventListener('click', function () {
              cambiaLike(f.codice, !haLike(f.codice), bottone);
            });
            var azioni = document.createElement('span');
            azioni.className = 'sel-azioni';
            azioni.appendChild(bottone);
            if (f.propria && !dati.chiuso) {
              var elimina = document.createElement('button');
              elimina.type = 'button';
              elimina.className = 'sel-elimina';
              elimina.textContent = testi.elimina;
              elimina.setAttribute('aria-label', testi.eliminaFoto + ' – ' + f.codice);
              elimina.addEventListener('click', function () {
                chiediElimina(f.codice);
              });
              azioni.appendChild(elimina);
            }
            riga.appendChild(codice);
            riga.appendChild(azioni);

            li.appendChild(link);
            li.appendChild(riga);
            galleria.appendChild(li);
          });

          classifica.textContent = '';
          dati.classifica.forEach(function (c, i) {
            var li = document.createElement('li');
            if (i < 20 && c.like > 0) li.className = 'finale';
            var pos = document.createElement('span');
            pos.className = 'sel-pos';
            pos.textContent = i + 1 + '.';
            li.appendChild(pos);
            var f = immagini[c.codice];
            if (f) {
              var img = document.createElement('img');
              img.src = f.img;
              img.alt = '';
              img.loading = 'lazy';
              li.appendChild(img);
            }
            var codice = document.createElement('span');
            codice.className = 'sel-codice';
            codice.textContent = c.codice;
            var n = document.createElement('span');
            n.className = 'meta';
            n.textContent = testoLike(c.like);
            li.appendChild(codice);
            li.appendChild(n);
            classifica.appendChild(li);
          });

          if (visore.open && aperta >= 0) {
            preparaLike(visoreLike, dati.foto[aperta].codice);
            preparaEliminaVisore();
          }
        }

        function aggiorna(risposta) {
          dati.miei = risposta.miei;
          dati.classifica = risposta.classifica;
          dati.chiuso = risposta.chiuso;
          disegna();
        }

        function cambiaLike(codice, valore, bottone) {
          bottone.disabled = true;
          mostraErrore('');
          chiama({
            azione: 'like',
            email: credenziali.email,
            password: credenziali.password,
            codice: codice,
            valore: valore,
          })
            .then(function (r) {
              if (r.ok) return aggiorna(r);
              if (r.errore === 'propria') {
                mostraErrore(testi.errorePropria);
                return disegna();
              }
              if (r.errore === 'chiuso') {
                mostraErrore(testi.erroreChiuso);
                dati.chiuso = true;
                return disegna();
              }
              if (r.errore === 'credenziali') return esci(testi.erroreCredenziali);
              throw new Error(r.errore);
            })
            .catch(function () {
              bottone.disabled = false;
              mostraErrore(testi.erroreRete);
            });
        }

        function mostraErrore(testo) {
          errore.textContent = testo || '';
          errore.hidden = !testo;
          // Con il visore aperto l'avviso della pagina resta coperto: lo ripeto nel visore
          if (visoreErrore) {
            visoreErrore.textContent = testo || '';
            visoreErrore.hidden = !testo;
          }
        }

        function entra(c) {
          form.hidden = true;
          mostraErrore('');
          stato.textContent = testi.caricamento;
          chiama({ azione: 'accesso', email: c.email, password: c.password })
            .then(function (r) {
              stato.textContent = '';
              if (!r.ok) return esci(r.errore === 'credenziali' ? testi.erroreCredenziali : testi.erroreRete);
              credenziali = c;
              scriviMemoria(c);
              dati = r;
              document.getElementById('sel-email').textContent = c.email;
              area.hidden = false;
              disegna();
            })
            .catch(function () {
              stato.textContent = '';
              form.hidden = false;
              mostraErrore(testi.erroreRete);
            });
        }

        function esci(messaggio) {
          credenziali = null;
          dati = null;
          scriviMemoria(null);
          area.hidden = true;
          form.hidden = false;
          form.reset();
          mostraErrore(messaggio || '');
        }

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          entra({
            email: form.email.value.trim().toLowerCase(),
            password: form.password.value.trim(),
          });
        });
        document.getElementById('sel-esci').addEventListener('click', function () {
          esci('');
        });

        // Chi è già entrato da questo dispositivo non deve riscrivere email e password
        var salvate = leggiMemoria();
        if (salvate) entra(salvate);
        else form.hidden = false;
      })();
    </script>
  )
}

<style>
  .meta {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .avviso {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    background: #fff;
  }

  .sel-accesso {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .sel-accesso[hidden],
  .avviso[hidden] {
    display: none;
  }

  .sel-accesso label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
